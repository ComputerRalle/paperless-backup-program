  Lines.Add('set -Eeuo pipefail');
  Lines.Add('export PATH=/usr/sbin:/usr/bin:/sbin:/bin');
  Lines.Add('export DEBIAN_FRONTEND=noninteractive');
  Lines.Add('umask 077');
  Lines.Add('step() { printf ''PAPERLESS_STEP:%s\n'' "$1"; }');
  Lines.Add('fail() { printf ''PAPERLESS_ERROR:%s\n'' "$1"; exit 1; }');
  Lines.Add('');
  Lines.Add('# Check the target before APT and serialize installer runs.');
  Lines.Add('# Ziel vor APT prüfen und parallele Installationen verhindern.');
  Lines.Add('step ''Debian und Installationsziel prüfen''');
  Lines.Add('[ "$(id -u)" -eq 0 ] || fail ''Die Installation benötigt den SSH-Benutzer root.''');
  Lines.Add('. /etc/os-release');
  Lines.Add('[ "$ID" = debian ] && [ "$VERSION_ID" = 13 ] && [ "$(dpkg --print-architecture)" = amd64 ] ||');
  Lines.Add('  fail ''Für die Installation wird Debian 13 (amd64) benötigt.''');
  Lines.Add('exec 9>/run/lock/paperless-backup-install.lock');
  Lines.Add('flock -n 9 || fail ''Auf dem Server läuft bereits eine Paperless-Installation.''');
  Lines.Add('check_target() {');
  Lines.Add('  [ ! -L "$target" ] || fail ''Der Installationsordner ist ein symbolischer Link.''');
  Lines.Add('  if [ -e "$target" ]; then');
  Lines.Add('    [ -d "$target" ] && [ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ] ||');
  Lines.Add('      fail "Unter $target sind bereits Dateien vorhanden. Die Installation wurde abgebrochen."');
  Lines.Add('  fi');
  Lines.Add('}');
  Lines.Add('check_target');
  Lines.Add('');
  // Docker is needed to detect existing containers and named volumes.
  // Docker wird benötigt, um vorhandene Container und benannte Volumes zu erkennen.
  Lines.Add('step ''Debian-Paketlisten aktualisieren''');
  Lines.Add('apt-get update </dev/null');
  Lines.Add('step ''Debian-Pakete aktualisieren''');
  Lines.Add('apt-get upgrade --with-new-pkgs -y </dev/null');
  Lines.Add('step ''Docker, Compose und curl installieren''');
  Lines.Add('apt-get install -y docker.io docker-compose curl </dev/null');
  Lines.Add('step ''Docker aktivieren und vorhandene Paperless-Daten prüfen''');
  Lines.Add('systemctl enable --now docker </dev/null');
  Lines.Add('unset DOCKER_CONTEXT DOCKER_HOST COMPOSE_FILE COMPOSE_PROJECT_NAME');
  Lines.Add('docker compose version');
  Lines.Add('containers=$(docker ps -aq --filter "label=com.docker.compose.project=$project")');
  Lines.Add('volumes=$(docker volume ls -q)');
  Lines.Add('[ -z "$containers" ] || fail "Das Docker-Projekt $project ist bereits vorhanden."');
  Lines.Add('for volume in data media export db_data_18; do');
  Lines.Add('  if grep -Fxq "${project}_$volume" <<< "$volumes"; then');
  Lines.Add('    fail "Ein Docker-Volume des Projekts $project ist bereits vorhanden."');
  Lines.Add('  fi');
  Lines.Add('done');
  Lines.Add('');
  Lines.Add('# Generate credentials on Debian and publish the prepared directory in one move.');
  Lines.Add('# Zugangsdaten auf Debian erzeugen und den vorbereiteten Ordner in einem Schritt freigeben.');
  Lines.Add('step ''Paperless-Konfiguration und Eingangsordner erstellen''');
  Lines.Add('stage=$(mktemp -d -- "${target%/*}/.paperless-install.XXXXXXXX")');
  Lines.Add('samba_tmp=''''');
  Lines.Add('trap ''if [ -n "$stage" ]; then rm -f -- "$stage/docker-compose.yml" "$stage/email-versand.env"; rmdir -- "$stage/consume" "$stage" 2>/dev/null || :; fi; if [ -n "$samba_tmp" ]; then rm -f -- "$samba_tmp"; fi'' EXIT');
  Lines.Add('db_password=$(od -An -N32 -tx1 /dev/urandom | tr -d '' \n'')');
  Lines.Add('secret_key=$(od -An -N32 -tx1 /dev/urandom | tr -d '' \n'')');
  Lines.Add('[ "${#db_password}" -eq 64 ] && [ "${#secret_key}" -eq 64 ] || fail ''Die Zugangsdaten konnten nicht erzeugt werden.''');
  Lines.Add('compose_template=$(cat <<''PAPERLESS_COMPOSE''');
  Lines.Add(ComposeContent.TrimRight);
  Lines.Add('PAPERLESS_COMPOSE');
  Lines.Add(')');
  Lines.Add('compose_template=${compose_template//__PAPERLESS_DB_PASSWORD__/$db_password}');
  Lines.Add('printf ''%s\n'' "${compose_template//__PAPERLESS_SECRET_KEY__/$secret_key}" >"$stage/docker-compose.yml"');
  Lines.Add('cat >"$stage/email-versand.env" <<''PAPERLESS_MAIL''');
  Lines.Add('PAPERLESS_EMAIL_HOST=');
  Lines.Add('PAPERLESS_EMAIL_PORT=25');
  Lines.Add('PAPERLESS_EMAIL_HOST_USER=');
  Lines.Add('PAPERLESS_EMAIL_HOST_PASSWORD=');
  Lines.Add('PAPERLESS_EMAIL_FROM=');
  Lines.Add('PAPERLESS_EMAIL_USE_TLS=false');
  Lines.Add('PAPERLESS_EMAIL_USE_SSL=false');
  Lines.Add('PAPERLESS_MAIL');
  Lines.Add('mkdir -m 0777 -- "$stage/consume"');
  Lines.Add('chmod 0755 -- "$stage"');
  Lines.Add('docker compose -f "$stage/docker-compose.yml" config --quiet </dev/null >/dev/null 2>&1 ||');
  Lines.Add('  fail ''Die erzeugte Compose-Datei konnte nicht validiert werden.''');
  Lines.Add('check_target');
  Lines.Add('if [ -d "$target" ]; then rmdir -- "$target"; fi');
  Lines.Add('mv -nT -- "$stage" "$target"');
  Lines.Add('[ ! -e "$stage" ] || fail ''Der Installationsordner wurde während der Vorbereitung belegt.''');
  Lines.Add('stage=''''');
  Lines.Add('printf ''PAPERLESS_CONFIG_CREATED\n''');
  Lines.Add('');
  Lines.Add('step ''Paperless-Container herunterladen und starten''');
  Lines.Add('cd -- "$target"');
  Lines.Add('docker compose --progress plain -f docker-compose.yml up -d </dev/null');
  // Check the published port on Debian before setting up the Samba share.
  // Den veröffentlichten Port auf Debian prüfen, bevor die Samba-Freigabe eingerichtet wird.
  Lines.Add('step ''Auf die Paperless-Weboberfläche warten''');
  Lines.Add('for ((attempt=1; attempt<=120; attempt++)); do');
  Lines.Add('  if curl --noproxy ''*'' --fail --silent --max-time 5 "http://127.0.0.1:$web_port/" >/dev/null; then');
  Lines.Add('    break');
  Lines.Add('  fi');
  Lines.Add('  [ "$attempt" -lt 120 ] || fail ''Die Paperless-Weboberfläche hat innerhalb der Wartezeit nicht geantwortet.''');
  Lines.Add('  sleep 5');
  Lines.Add('done');
  Lines.Add('');
  Lines.Add('# Validate the Samba configuration before replacing the live file.');
  Lines.Add('# Die Samba-Konfiguration prüfen, bevor sie übernommen wird.');
  Lines.Add('step ''Samba installieren''');
  Lines.Add('apt-get install -y samba </dev/null');
  Lines.Add('step ''Samba-Gastfreigabe paperless-consume einrichten''');
  Lines.Add('smb_conf=/etc/samba/smb.conf');
  Lines.Add('if grep -Eiq ''^[[:space:]]*\[paperless-consume\][[:space:]]*([#;].*)?$'' "$smb_conf"; then');
  Lines.Add('  fail ''Die Samba-Freigabe paperless-consume ist bereits vorhanden.''');
  Lines.Add('fi');
  Lines.Add('samba_tmp=$(mktemp -- /etc/samba/.paperless-install.XXXXXXXX)');
  Lines.Add('cp -p -- "$smb_conf" "$samba_tmp"');
  Lines.Add('printf ''\n[paperless-consume]\n   path = %s/consume\n'' "$target" >>"$samba_tmp"');
  Lines.Add('cat >>"$samba_tmp" <<''PAPERLESS_SAMBA''');
  Lines.Add('   browseable = yes');
  Lines.Add('   writable = yes');
  Lines.Add('   guest ok = yes');
  Lines.Add('   create mask = 0777');
  Lines.Add('   directory mask = 0777');
  Lines.Add('PAPERLESS_SAMBA');
  Lines.Add('testparm -s --section-name=paperless-consume "$samba_tmp" </dev/null >/dev/null');
  Lines.Add('chmod -R 0777 -- "$target/consume"');
  Lines.Add('mv -T -- "$samba_tmp" "$smb_conf"');
  Lines.Add('samba_tmp=''''');
  Lines.Add('systemctl enable smbd </dev/null');
  Lines.Add('systemctl restart smbd </dev/null');
  Lines.Add('systemctl is-active --quiet smbd');
  Lines.Add('step ''Paperless und Samba sind gestartet''');
  Lines.Add('printf ''PAPERLESS_INSTALL_COMPLETE\n''');
