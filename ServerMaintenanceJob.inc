// Detach maintenance and reconnect its observer; never restart a completed job.
// Wartung ablösen und Überwachung neu verbinden; fertige Aufträge nie erneut starten.
  Lines.Add('function JobSsh([string]$cmd,[byte[]]$bytes=$null) {');
  Lines.Add(' $si=New-Object Diagnostics.ProcessStartInfo');
  Lines.Add(' $si.FileName=(Get-Command ssh.exe -ErrorAction Stop).Source');
  Lines.Add(' $a=@(''-T'',''-o'',''StrictHostKeyChecking=yes'',''-o'',''UpdateHostKeys=no'',''-o'',''ConnectTimeout=5'',''-o'',''ServerAliveInterval=5'',''-o'',''ServerAliveCountMax=1'',''-o'',''NumberOfPasswordPrompts=1'',''-p'',$port,''-l'',$serverUser)');
  Lines.Add(' if($useKey){$a+=@(''-o'',''IdentitiesOnly=yes'',''-i'',$keyFile)}else{$a+=@(''-o'',''PreferredAuthentications=password'',''-o'',''PubkeyAuthentication=no'')}');
  Lines.Add(' $a+=@($serverHost,$cmd);$si.Arguments=(($a|ForEach-Object{WinArg $_}) -join '' '')');
  Lines.Add(' $si.UseShellExecute=$false;$si.CreateNoWindow=$true');
  Lines.Add(' $si.RedirectStandardInput=$true;$si.RedirectStandardOutput=$true;$si.RedirectStandardError=$true');
  Lines.Add(' $si.StandardOutputEncoding=[Text.Encoding]::UTF8;$si.StandardErrorEncoding=[Text.Encoding]::UTF8');
  Lines.Add(' $p=New-Object Diagnostics.Process;$p.StartInfo=$si;$started=$false');
  Lines.Add(' try {');
  Lines.Add('  if(-not $p.Start()){throw ''ssh_start''};$started=$true');
  Lines.Add('  $out=$p.StandardOutput.ReadToEndAsync();$err=$p.StandardError.ReadToEndAsync()');
  Lines.Add('  if($bytes){$write=$p.StandardInput.BaseStream.WriteAsync($bytes,0,$bytes.Length);if(-not $write.Wait(30000)){throw ''ssh_timeout''}}');
  Lines.Add('  $p.StandardInput.Close()');
  Lines.Add('  if(-not $p.WaitForExit(30000) -or -not $out.Wait(5000) -or -not $err.Wait(5000)){throw ''ssh_timeout''}');
  Lines.Add('  if($p.ExitCode -ne 0){throw (''ssh_exit_''+$p.ExitCode)}');
  Lines.Add('  return $out.Result');
  Lines.Add(' } finally {');
  Lines.Add('  if($started -and -not $p.HasExited){try{$p.Kill();[void]$p.WaitForExit(2000)}catch{}}');
  Lines.Add('  $p.Dispose()');
  Lines.Add(' }');
  Lines.Add('}');
  Lines.Add('function InvokeDetachedJob([string]$worker,[string]$arguments='''') {');
  Lines.Add(' $job=''/var/tmp/paperless-job-''+[Guid]::NewGuid().ToString(''N'');$q=ShArg $job');
  Lines.Add(' $log.WriteLine(''Serverauftrag: ''+$job)');
  Lines.Add(' $runner=@''');
  Lines.Add('#!/bin/bash');
  Lines.Add('set -u');
  Lines.Add('umask 077');
  Lines.Add('cd -- "$(dirname -- "$0")" || exit 1');
  Lines.Add('exec >>output.log 2>&1');
  Lines.Add('exec 9>>job.lock');
  Lines.Add('flock -n 9 || exit 0');
  Lines.Add('[ ! -f result ] || exit 0');
  Lines.Add('[ ! -f started ] || exit 0');
  Lines.Add('printf ''started\n'' >started');
  Lines.Add('finish() {');
  Lines.Add(' status=$?');
  Lines.Add(' trap - EXIT');
  Lines.Add(' printf ''%s\n'' "$status" >result.tmp && mv -f result.tmp result');
  Lines.Add('}');
  Lines.Add('trap finish EXIT');
  Lines.Add('bash ./worker.sh');
  Lines.Add('''@');
  Lines.Add(' $payload=''set -- ''+$arguments+[char]10+$worker.Replace([string][char]13,'''')+[char]10');
  Lines.Add(' $worker64=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($payload))');
  Lines.Add(' $runner64=[Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($runner.Replace([string][char]13,'''')+[char]10))');
  Lines.Add(' $prepare=@''');
  Lines.Add('set -eu');
  Lines.Add('umask 077');
  Lines.Add('command -v setsid >/dev/null');
  Lines.Add('command -v nohup >/dev/null');
  Lines.Add('command -v flock >/dev/null');
  Lines.Add('job=JOB_PATH');
  Lines.Add('if [ ! -d "$job" ]; then mkdir -m 700 -- "$job"; fi');
  Lines.Add('[ ! -L "$job" ] && [ -O "$job" ] && [ "$(stat -c %a "$job")" = 700 ] || exit 73');
  Lines.Add('cd -- "$job"');
  Lines.Add('printf ''%s'' ''WORKER_DATA'' | base64 -d >worker.tmp');
  Lines.Add('bash -n worker.tmp');
  Lines.Add('mv -f worker.tmp worker.sh');
  Lines.Add('printf ''%s'' ''RUNNER_DATA'' | base64 -d >runner.tmp');
  Lines.Add('bash -n runner.tmp');
  Lines.Add('mv -f runner.tmp runner.sh');
  Lines.Add('printf ''PREPARED\n''');
  Lines.Add('''@');
  Lines.Add(' $prepare=$prepare.Replace(''JOB_PATH'',$q).Replace(''WORKER_DATA'',$worker64).Replace(''RUNNER_DATA'',$runner64)');
  Lines.Add(' while($true){');
  Lines.Add('  try {');
  Lines.Add('   $answer=JobSsh ''bash -s'' ([Text.Encoding]::UTF8.GetBytes($prepare.Replace([string][char]13,'''')+[char]10))');
  Lines.Add('   if($answer.Trim() -ne ''PREPARED''){throw ''job_prepare''}');
  Lines.Add('   break');
  Lines.Add('  } catch {');
  Lines.Add('   if($_.Exception.Message -notmatch ''^ssh_(exit_255|timeout|start)$''){throw}');
  Lines.Add('   SetProgress ''SSH-Verbindung unterbrochen. Vorbereitung wird in 5 Sekunden erneut versucht.''');
  Lines.Add('   Start-Sleep -Seconds 5');
  Lines.Add('  }');
  Lines.Add(' }');
  Lines.Add(' # Root jobs use the system manager, including protection from login-session cleanup.');
  Lines.Add(' # Root-Aufträge laufen unter dem Systemmanager, unabhängig vom Aufräumen der Anmeldesitzung.');
  Lines.Add(' $launchScript=@''');
  Lines.Add('set -eu');
  Lines.Add('cd -- JOB_PATH');
  Lines.Add('if [ "$(id -u)" = 0 ] && [ -d /run/systemd/system ]; then');
  Lines.Add(' unit=paperless-job-UNIT_ID');
  Lines.Add(' if [ -f started ] || systemctl is-active --quiet "$unit"; then exit 0; fi');
  Lines.Add(' systemd-run --quiet --unit="$unit" --service-type=exec /bin/bash "$PWD/runner.sh"');
  Lines.Add('else');
  Lines.Add(' (nohup setsid bash ./runner.sh </dev/null >/dev/null 2>&1 &) </dev/null >/dev/null 2>&1');
  Lines.Add('fi');
  Lines.Add('''@');
  Lines.Add(' $launch=''bash -c ''+(ShArg $launchScript.Replace(''JOB_PATH'',$q).Replace(''UNIT_ID'',$job.Substring($job.LastIndexOf(''-'')+1)).Replace([string][char]13,''''))');
  Lines.Add(' $offset=0;$launched=$false;$reconnecting=$false');
  Lines.Add(' while($true){');
  Lines.Add('  try {');
  Lines.Add('   if(-not $launched){$null=JobSsh $launch;$launched=$true}');
  Lines.Add('   $poll=@''');
  Lines.Add('set -eu');
  Lines.Add('cd -- JOB_PATH');
  Lines.Add('state=waiting');
  Lines.Add('if [ -f result ]; then state=done:$(cat result)');
  Lines.Add('elif [ -f started ]; then');
  Lines.Add(' state=running');
  Lines.Add(' if flock -n job.lock true; then');
  Lines.Add('  if [ -f result ]; then state=done:$(cat result); else state=interrupted; fi');
  Lines.Add(' fi');
  Lines.Add('fi');
  Lines.Add('end=0');
  Lines.Add('if [ -f output.log ]; then end=$(wc -l <output.log); fi');
  Lines.Add('limit=$((OFFSET+200))');
  Lines.Add('if [ "$end" -gt "$limit" ]; then end=$limit; state=running; fi');
  Lines.Add('printf ''PAPERLESS_JOB:%s:%s\n'' "$state" "$end"');
  Lines.Add('if [ "$end" -gt OFFSET ]; then sed -n "$((OFFSET+1)),$end p" output.log; fi');
  Lines.Add('''@');
  Lines.Add('   $poll=$poll.Replace(''JOB_PATH'',$q).Replace(''OFFSET'',[string]$offset)');
  Lines.Add('   $answer=JobSsh (''bash -c ''+(ShArg $poll.Replace([string][char]13,'''')))');
  Lines.Add('   $rows=$answer -split [char]10');
  Lines.Add('   if($rows[0] -notmatch ''^PAPERLESS_JOB:(waiting|running|interrupted|done:\d+):(\d+)$''){throw ''job_status''}');
  Lines.Add('   $state=$matches[1];$next=[int]$matches[2]');
  Lines.Add('   if($next -lt $offset -or ($rows.Length-2) -ne ($next-$offset)){throw ''job_status''}');
  Lines.Add('   for($i=1;$i -lt $rows.Length-1;$i++){');
  Lines.Add('    $line=$rows[$i].TrimEnd([char]13);$log.WriteLine($line)');
  Lines.Add('    if($line.StartsWith(''PAPERLESS_STEP:'')){$script:installStep=$line.Substring(15);SetProgress $script:installStep}');
  Lines.Add('    elseif($line.StartsWith(''PAPERLESS_ERROR:'')){$script:installFailure=$line.Substring(16)}');
  Lines.Add('    elseif($line -eq ''PAPERLESS_CONFIG_CREATED''){$script:installConfigCreated=$true}');
  Lines.Add('    elseif($line -eq ''PAPERLESS_INSTALL_COMPLETE''){$script:installReady=$true}');
  Lines.Add('   }');
  Lines.Add('   $offset=$next');
  Lines.Add('   if($reconnecting){SetProgress $script:installStep;$reconnecting=$false}');
  Lines.Add('   if($state -eq ''interrupted''){throw ''job_interrupted''}');
  Lines.Add('   if($state.StartsWith(''done:'')){');
  Lines.Add('    $code=[int]$state.Substring(5)');
  Lines.Add('    if($code -ne 0){throw (''job_exit_''+$code)}');
  Lines.Add('    return');
  Lines.Add('   }');
  Lines.Add('   if($state -eq ''waiting''){$launched=$false}');
  Lines.Add('  } catch {');
  Lines.Add('   if($_.Exception.Message -notmatch ''^ssh_(exit_255|timeout|start)$''){throw}');
  Lines.Add('   $reconnecting=$true');
  Lines.Add('   SetProgress ''SSH-Verbindung unterbrochen. Serverauftrag bleibt unabhängig. Neuer Verbindungsversuch in 5 Sekunden.''');
  Lines.Add('  }');
  Lines.Add('  Start-Sleep -Seconds 5');
  Lines.Add(' }');
  Lines.Add('}');
