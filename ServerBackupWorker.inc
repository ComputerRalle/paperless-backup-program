// Embed the Linux launcher and worker so an EXE can deploy them without local script files.
// Linux-Starter und Backupskript einbetten, damit die EXE sie ohne lokale Skriptdateien bereitstellt.
function ServerBackupLaunchScript: string;
var
  Lines: TStringList;
begin
  Lines := TStringList.Create;
  try
    Lines.Add('set -eu');
    Lines.Add('umask 077');
    Lines.Add('stage=''Docker-Verbindung pruefen''');
    Lines.Add('build_dir=');
    Lines.Add('finish_launch() {');
    Lines.Add('  rc=$?');
    Lines.Add('  trap - EXIT');
    Lines.Add('  if [ -n "$build_dir" ]; then rm -f -- "$build_dir/Dockerfile" "$build_dir/worker.sh"; rmdir -- "$build_dir" || :; fi');
    Lines.Add('  if [ "$rc" -ne 0 ]; then printf ''ERROR: %s (Exitcode %s).\n'' "$stage" "$rc"; fi');
    Lines.Add('  exit 0');
    Lines.Add('}');
    Lines.Add('trap finish_launch EXIT');
    Lines.Add('trap ''exit 1'' HUP INT TERM');
    Lines.Add('');
    Lines.Add('# Keep Docker discovery, bind paths and the worker on the same local daemon.');
    Lines.Add('# Docker-Ermittlung, Bind-Pfade und Backupcontainer auf demselben lokalen Daemon halten.');
    Lines.Add('socket=/var/run/docker.sock');
    Lines.Add('[ -S "$socket" ]');
    Lines.Add('case "${DOCKER_HOST:-unix://$socket}" in "unix://$socket") ;; *) exit 1;; esac');
    Lines.Add('[ "$(docker context inspect --format ''{{.Endpoints.docker.Host}}'' 2>/dev/null)" = "unix://$socket" ]');
    Lines.Add('docker info >/dev/null 2>&1');
    Lines.Add('');
    Lines.Add('# Use a fixed container name as a daemon-side lock and verify its ownership before reuse.');
    Lines.Add('# Einen festen Containernamen als Sperre verwenden und vor der Wiederverwendung das Label pruefen.');
    Lines.Add('stage=''Vorhandenen Backuplauf pruefen''');
    Lines.Add('old=$(docker ps -aq --no-trunc --filter "name=^/$job$" 2>/dev/null)');
    Lines.Add('if [ -n "$old" ]; then');
    Lines.Add('  [ "$(docker inspect --format ''{{index .Config.Labels "de.computerralle.paperless.backup"}}'' "$old" 2>/dev/null)" = pg18 ]');
    Lines.Add('  old_status=$(docker inspect --format ''{{.State.Status}}'' "$old" 2>/dev/null)');
    Lines.Add('  case "$old_status" in');
    Lines.Add('    running|restarting|paused) printf ''%s\n'' ''OK: Vorhandener Backuplauf''; exit 0;;');
    Lines.Add('    created|exited|dead) ;;');
    Lines.Add('    *) exit 1;;');
    Lines.Add('  esac');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('stage=''Compose-Datei und laufende Container ermitteln''');
    Lines.Add('compose_dir=${compose%/*}');
    Lines.Add('[ -n "$compose_dir" ] || compose_dir=/');
    Lines.Add('cd -- "$compose_dir"');
    Lines.Add('[ -r "$compose" ]');
    Lines.Add('compose_cmd() {');
    Lines.Add('  if [ -n "$project" ]; then docker compose -f "$compose" -p "$project" "$@"');
    Lines.Add('  else docker compose -f "$compose" "$@"; fi');
    Lines.Add('}');
    Lines.Add('web=$(compose_cmd ps -q paperless 2>/dev/null)');
    Lines.Add('db=$(compose_cmd ps -q db 2>/dev/null)');
    Lines.Add('case "$web" in ''''|*[!a-f0-9]*) exit 1;; esac');
    Lines.Add('case "$db" in ''''|*[!a-f0-9]*) exit 1;; esac');
    Lines.Add('[ "$web" != "$db" ]');
    Lines.Add('version=$(docker exec "$db" postgres --version 2>/dev/null)');
    Lines.Add('case "$version" in ''postgres (PostgreSQL) 18.''*) ;; *) stage=''PostgreSQL 18 pruefen''; exit 1;; esac');
    Lines.Add('broker=$(compose_cmd ps -q broker 2>/dev/null || :)');
    Lines.Add('gotenberg=$(compose_cmd ps -q gotenberg 2>/dev/null || :)');
    Lines.Add('tika=$(compose_cmd ps -q tika 2>/dev/null || :)');
    Lines.Add('');
    // Resolve the host paths from the running containers before creating the worker's bind mounts.
    // Vor dem Einbinden in den Backupcontainer die Hostpfade aus den laufenden Containern ermitteln.
    Lines.Add('mount_source() {');
    Lines.Add('  source=$(docker inspect --format "{{range .Mounts}}{{if eq .Destination \"$2\"}}{{println .Source}}{{end}}{{end}}" "$1" 2>/dev/null) || return 1');
    Lines.Add('  case "$source" in /*) ;; *) return 1;; esac');
    Lines.Add('  case "$source" in *,*|*\"*|*''');
    Lines.Add('''*) return 1;; esac');
    Lines.Add('  realpath -e -- "$source"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('stage=''Backupquellen aus den laufenden Containern ermitteln''');
    Lines.Add('data=$(mount_source "$web" /usr/src/paperless/data)');
    Lines.Add('media=$(mount_source "$web" /usr/src/paperless/media)');
    Lines.Add('export_dir=$(mount_source "$web" /usr/src/paperless/export)');
    Lines.Add('dbdata=$(mount_source "$db" /var/lib/postgresql)');
    Lines.Add('for source in "$data" "$media" "$export_dir" "$dbdata"; do');
    Lines.Add('  [ "$source" != / ] && [ -d "$source" ] && [ -r "$source" ]');
    Lines.Add('done');
    Lines.Add('# An export below /mnt must be backed by an active mount, not a fallback directory on root.');
    Lines.Add('# Exportpfade unter /mnt muessen aktiv eingehaengt sein, damit kein leerer Ersatzordner gesichert wird.');
    Lines.Add('case "$export_dir" in');
    Lines.Add('  /mnt/*)');
    Lines.Add('    stage=''Export-Mount unter /mnt pruefen''');
    Lines.Add('    export_mount=$(findmnt -n -o TARGET --target "$export_dir")');
    Lines.Add('    case "$export_mount" in /mnt|/mnt/*) ;; *) exit 1;; esac');
    Lines.Add('    ;;');
    Lines.Add('esac');
    Lines.Add('');
    Lines.Add('stage=''Backupordner und freien Speicher pruefen''');
    Lines.Add('target=$(realpath -e -- "$target")');
    Lines.Add('case "$target" in /|*,*|*\"*|*''');
    Lines.Add('''*) exit 1;; esac');
    Lines.Add('[ -d "$target" ] && [ -w "$target" ]');
    Lines.Add('total=0');
    Lines.Add('db_size=0');
    Lines.Add('for source in "$data" "$media" "$export_dir" "$dbdata"; do');
    Lines.Add('  case "$target/" in "$source/"*) exit 1;; esac');
    Lines.Add('  case "$source/" in "$target/"*) exit 1;; esac');
    Lines.Add('  measure=$(du -sb -- "$source")');
    Lines.Add('  bytes=${measure%%[!0-9]*}');
    Lines.Add('  case "$bytes" in ''''|*[!0-9]*) exit 1;; esac');
    Lines.Add('  total=$((total + bytes))');
    Lines.Add('  if [ "$source" = "$dbdata" ]; then db_size=$bytes; fi');
    Lines.Add('done');
    Lines.Add('space=$(df -B1 --output=avail -- "$target" | awk ''NR == 2 { print $1 }'')');
    Lines.Add('case "$space" in ''''|*[!0-9]*) exit 1;; esac');
    // Budget for the uncompressed sources, a separate database dump and a safety reserve.
    // Platz für die unkomprimierten Quelldaten, den zusätzlichen Datenbankdump und eine Reserve einplanen.
    Lines.Add('required=$((total + db_size + total / 10 + 1073741824))');
    Lines.Add('if [ "$space" -lt "$required" ]; then');
    Lines.Add('  stage="Freier Speicher: $space Bytes, benoetigt: ca. $required Bytes"');
    Lines.Add('  exit 1');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('# Build the controlled worker image before stopping any application service.');
    Lines.Add('# Das eigene Backupimage bauen, bevor ein Anwendungsdienst gestoppt wird.');
    Lines.Add('stage=''Docker-Backupimage bereitstellen''');
    Lines.Add('build_dir=$(mktemp -d)');
    Lines.Add('cat > "$build_dir/Dockerfile" <<''PAPERLESS_DOCKERFILE''');
    Lines.Add('FROM docker:cli');
    Lines.Add('COPY worker.sh /paperless-backup.sh');
    Lines.Add('RUN ["/bin/sh", "-n", "/paperless-backup.sh"]');
    Lines.Add('ENTRYPOINT ["/bin/sh", "/paperless-backup.sh"]');
    Lines.Add('PAPERLESS_DOCKERFILE');
    Lines.Add('cat > "$build_dir/worker.sh" <<''PAPERLESS_WORKER''');
    Lines.Add('#!/bin/sh');
    Lines.Add('set -eu');
    Lines.Add('umask 077');
    Lines.Add('stage=''Backup vorbereiten''');
    Lines.Add('restart_db=0');
    Lines.Add('restart_web=0');
    Lines.Add('');
    Lines.Add('# Restore services stopped by this run, even when an archive fails.');
    Lines.Add('# Die in diesem Lauf gestoppten Dienste auch bei Archivfehlern starten.');
    Lines.Add('resume_services() {');
    Lines.Add('  if [ "$restart_db" -eq 1 ]; then');
    Lines.Add('    docker start "$db" >/dev/null 2>&1 || return 1');
    Lines.Add('    tries=0');
    Lines.Add('    until docker exec "$db" sh -c ''pg_isready -q -U "${POSTGRES_USER:-paperless}" -d "${POSTGRES_DB:-paperless}"'' >/dev/null 2>&1; do');
    Lines.Add('      tries=$((tries + 1))');
    Lines.Add('      [ "$tries" -lt 60 ] || return 1');
    Lines.Add('      sleep 2');
    Lines.Add('    done');
    Lines.Add('    restart_db=0');
    Lines.Add('  fi');
    Lines.Add('  if [ "$restart_web" -eq 1 ]; then');
    Lines.Add('    docker start "$web" >/dev/null 2>&1 || return 1');
    Lines.Add('    [ "$(docker inspect --format ''{{.State.Running}}'' "$web" 2>/dev/null)" = true ] || return 1');
    Lines.Add('    restart_web=0');
    Lines.Add('  fi');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('finish() {');
    Lines.Add('  rc=$?');
    Lines.Add('  trap - EXIT');
    Lines.Add('  trap '''' HUP INT TERM');
    Lines.Add('  if ! resume_services; then');
    Lines.Add('    printf ''%s\n'' ''FEHLER: Paperless oder PostgreSQL konnte nicht wieder gestartet werden. Bitte auf dem Server pruefen.''');
    Lines.Add('    rc=1');
    Lines.Add('  fi');
    Lines.Add('  if [ "$rc" -ne 0 ]; then');
    Lines.Add('    printf ''FEHLER: %s. Unvollstaendige Dateien liegen gegebenenfalls unter %s.\n'' "$stage" "$partial"');
    Lines.Add('  fi');
    Lines.Add('  exit "$rc"');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('web=$1');
    Lines.Add('db=$2');
    Lines.Add('run=$3');
    Lines.Add('prefix=$4');
    Lines.Add('broker=$5');
    Lines.Add('gotenberg=$6');
    Lines.Add('tika=$7');
    Lines.Add('host_target=$8');
    Lines.Add('required=$9');
    Lines.Add('stamp=${10}');
    // Keep unfinished backups outside the timestamp naming scheme used by listing and download.
    // Unfertige Sicherungen vom Zeitstempelformat für Auflistung und Download fernhalten.
    Lines.Add('partial="/backup/.paperless-$run.partial"');
    Lines.Add('final="/backup/$stamp"');
    Lines.Add('trap finish EXIT');
    Lines.Add('trap ''exit 1'' HUP INT TERM');
    Lines.Add('stage=''Freien Speicher unmittelbar vor der Sicherung erneut pruefen''');
    Lines.Add('free_kib=$(df -Pk /backup | awk ''NR == 2 { print $4 }'')');
    Lines.Add('case "$free_kib" in ''''|*[!0-9]*) exit 1;; esac');
    Lines.Add('[ "$free_kib" -ge $(((required + 1023) / 1024)) ]');
    Lines.Add('[ ! -e "$final" ] && [ ! -L "$final" ]');
    Lines.Add('mkdir -- "$partial"');
    Lines.Add('[ "$(docker inspect --format ''{{.State.Running}}'' "$web" 2>/dev/null)" = true ]');
    Lines.Add('[ "$(docker inspect --format ''{{.State.Running}}'' "$db" 2>/dev/null)" = true ]');
    Lines.Add('printf ''Backup auf dem Server gestartet. Lauf-ID: %s\n'' "$run"');
    Lines.Add('');
    Lines.Add('# Capture metadata before stopping Paperless; never send the key to the log.');
    Lines.Add('# Metadaten vor dem Stopp sichern und den Schluessel aus dem Log heraushalten.');
    Lines.Add('stage=''Paperless-Schluessel sichern''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('key=$(docker exec "$web" sh -c ''');
    Lines.Add('  if [ -n "${PAPERLESS_SECRET_KEY:-}" ]; then printf "%s" "$PAPERLESS_SECRET_KEY"');
    Lines.Add('  elif [ -n "${PAPERLESS_SECRET_KEY_FILE:-}" ]; then cat -- "$PAPERLESS_SECRET_KEY_FILE"');
    Lines.Add('  else exit 1; fi'' 2>/dev/null)');
    Lines.Add('case "$key" in ''''|*''');
    Lines.Add('''*) exit 1;; esac');
    Lines.Add('printf ''PAPERLESS_SECRET_KEY=%s\n'' "$key" > "$partial/paperless_secret_key.txt"');
    Lines.Add('unset key');
    Lines.Add('stage=''Image-Versionen und Maildatei sichern''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('image_version() {');
    Lines.Add('  if [ -z "$1" ]; then printf ''%s'' unbekannt; return; fi');
    Lines.Add('  ref=$(docker inspect --format ''{{.Config.Image}}'' "$1" 2>/dev/null) || return 1');
    Lines.Add('  case "${ref##*/}" in');
    Lines.Add('    *@*) printf ''%s'' "${ref##*@}";;');
    Lines.Add('    *:*) printf ''%s'' "${ref##*:}";;');
    Lines.Add('    *) printf ''%s'' latest;;');
    Lines.Add('  esac');
    Lines.Add('}');
    Lines.Add('{');
    Lines.Add('  printf ''%s\n'' ''Paperless Backup - Toolversionen zum Zeitpunkt des Backups'' ''---------------------------------------------------------''');
    Lines.Add('  printf ''Paperless-Version: %s\n'' "$(image_version "$web")"');
    Lines.Add('  printf ''Postgres-Version: %s\n'' "$(image_version "$db")"');
    Lines.Add('  printf ''Valkey-Version: %s\n'' "$(image_version "$broker")"');
    Lines.Add('  printf ''Gotenberg-Version: %s\n'' "$(image_version "$gotenberg")"');
    Lines.Add('  printf ''Tika-Version: %s\n'' "$(image_version "$tika")"');
    Lines.Add('  printf ''Alpine-Version: unbekannt\nBusybox-Version: unbekannt\n\nBackup erstellt am: %s\n'' "$stamp"');
    Lines.Add('} > "$partial/image_versionen.txt"');
    Lines.Add('if [ -f /source-mail.enc ]; then cp -- /source-mail.enc "$partial/email-versand.env.enc"; fi');
    Lines.Add('');
    Lines.Add('# Stop application writers before the logical dump and stop PostgreSQL before its physical archive.');
    Lines.Add('# Paperless vor dem SQL-Dump und PostgreSQL vor dem physischen Archiv stoppen.');
    Lines.Add('stage=''Paperless stoppen''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('restart_web=1');
    Lines.Add('docker stop -t 90 "$web" >/dev/null 2>&1');
    Lines.Add('web_state=$(docker inspect --format ''{{.State.Running}}:{{.State.ExitCode}}'' "$web" 2>/dev/null)');
    Lines.Add('case "$web_state" in false:137) exit 1;; false:*) ;; *) exit 1;; esac');
    Lines.Add('stage=''UTF-8-SQL-Dump erstellen''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('dump="$partial/$prefix-db-1_backup.sql"');
    Lines.Add('docker exec "$db" sh -c ''');
    Lines.Add('  if [ -n "${POSTGRES_PASSWORD:-}" ]; then export PGPASSWORD="$POSTGRES_PASSWORD"');
    Lines.Add('  elif [ -n "${POSTGRES_PASSWORD_FILE:-}" ]; then PGPASSWORD=$(cat -- "$POSTGRES_PASSWORD_FILE") || exit 1; export PGPASSWORD; fi');
    Lines.Add('  exec pg_dump -w --encoding=UTF8 --no-owner --no-privileges -U "${POSTGRES_USER:-paperless}" -d "${POSTGRES_DB:-paperless}"');
    Lines.Add(''' > "$dump" 2>/dev/null');
    Lines.Add('[ -s "$dump" ]');
    Lines.Add('stage=''PostgreSQL sauber stoppen''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('restart_db=1');
    Lines.Add('docker stop -t 120 "$db" >/dev/null 2>&1');
    Lines.Add('[ "$(docker inspect --format ''{{.State.Running}}:{{.State.ExitCode}}'' "$db" 2>/dev/null)" = false:0 ]');
    Lines.Add('');
    Lines.Add('for role in data db_data_18 export media; do');
    Lines.Add('  stage="Archiv $role schreiben"');
    Lines.Add('  printf ''%s\n'' "$stage"');
    Lines.Add('  tar -czf "$partial/${prefix}_$role.tar.gz" -C "/source-$role" . 2>/dev/null');
    Lines.Add('done');
    Lines.Add('');
    Lines.Add('# Bring Paperless back before validating the archives and publishing the completed directory.');
    Lines.Add('# Paperless vor der Archivpruefung und der Freigabe des fertigen Ordners wieder starten.');
    Lines.Add('stage=''Paperless und PostgreSQL wieder starten''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('resume_services');
    Lines.Add('stage=''Archive lesen und pruefen''');
    Lines.Add('printf ''%s\n'' "$stage"');
    Lines.Add('for role in data db_data_18 export media; do');
    Lines.Add('  tar -tzf "$partial/${prefix}_$role.tar.gz" >/dev/null 2>&1');
    Lines.Add('done');
    Lines.Add('stage=''Fertigen Backupordner freigeben''');
    Lines.Add('printf ''%s\n'' "$stage"');
    // Publish only after service restart and archive validation, keeping any existing timestamp folder.
    // Erst nach Dienststart und Archivprüfung freigeben und vorhandene Zeitstempelordner erhalten.
    Lines.Add('mv -T -n -- "$partial" "$final"');
    Lines.Add('[ ! -e "$partial" ]');
    Lines.Add('printf ''Backup abgeschlossen: %s/%s\n'' "$host_target" "$stamp"');
    Lines.Add('PAPERLESS_WORKER');
    Lines.Add('image_hash=$(sha256sum "$build_dir/worker.sh" "$build_dir/Dockerfile" | awk ''{print $1}'' | sha256sum)');
    Lines.Add('image="paperless-backup-pg18:${image_hash%% *}"');
    Lines.Add('if ! docker image inspect "$image" >/dev/null 2>&1; then');
    Lines.Add('  docker build -q -t "$image" "$build_dir" >/dev/null 2>&1');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('stage=''Backupcontainer starten''');
    Lines.Add('if [ -n "$old" ]; then docker rm "$old" >/dev/null 2>&1; fi');
    Lines.Add('set -- --detach --name "$job" --restart=no --network none --stop-timeout 240 --log-driver local \');
    Lines.Add('  --label de.computerralle.paperless.backup=pg18 \');
    Lines.Add('  --mount "type=bind,src=$socket,dst=/var/run/docker.sock" \');
    Lines.Add('  --mount "type=bind,src=$target,dst=/backup" \');
    Lines.Add('  --mount "type=bind,src=$data,dst=/source-data,readonly" \');
    Lines.Add('  --mount "type=bind,src=$media,dst=/source-media,readonly" \');
    Lines.Add('  --mount "type=bind,src=$export_dir,dst=/source-export,readonly" \');
    Lines.Add('  --mount "type=bind,src=$dbdata,dst=/source-db_data_18,readonly"');
    Lines.Add('mail="${compose_dir%/}/email-versand.env.enc"');
    Lines.Add('if [ -f "$mail" ]; then');
    Lines.Add('  case "$mail" in *,*|*\"*|*''');
    Lines.Add('''*) exit 1;; esac');
    Lines.Add('  set -- "$@" --mount "type=bind,src=$mail,dst=/source-mail.enc,readonly"');
    Lines.Add('fi');
    Lines.Add('stamp=$(date +%Y-%m-%d_%H-%M-%S)');
    Lines.Add('if ! docker run "$@" "$image" "$web" "$db" "$run" "$prefix" "$broker" "$gotenberg" "$tika" "$target" "$required" "$stamp" >/dev/null 2>&1; then');
    Lines.Add('  # Another launcher may have acquired the container name in the meantime.');
    Lines.Add('  # Ein anderer Aufruf kann den Containernamen zwischenzeitlich belegt haben.');
    Lines.Add('  [ "$(docker inspect --format ''{{index .Config.Labels "de.computerralle.paperless.backup"}}:{{.State.Running}}'' "$job" 2>/dev/null)" = pg18:true ]');
    Lines.Add('fi');
    Lines.Add('printf ''OK: Freier Speicher %s Bytes; geschaetzter Platzbedarf mit Reserve %s Bytes.\n'' "$space" "$required"');
    Result := StringReplace(Lines.Text, sLineBreak, #10, [rfReplaceAll]);
  finally
    Lines.Free;
  end;
end;
