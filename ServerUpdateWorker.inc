  Lines.Add('step ''Paperless-Dienste herunterfahren''');
  Lines.Add('stopped=1');
  Lines.Add('dc "$compose" down </dev/null');
  Lines.Add('cmp -s -- "$compose" "$backup" || fail ''Die Compose-Datei wurde während des Stoppens geändert.''');
