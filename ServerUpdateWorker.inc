  Lines.Add('    ("postgres",),');
  Lines.Add('    ("gotenberg/gotenberg",),');
  Lines.Add('    ("apache/tika",),');
  Lines.Add('    ("alpine",),');
  Lines.Add('    ("busybox",),');
  Lines.Add(')');
  Lines.Add('model = json.loads((work / "before.json").read_text())');
  Lines.Add('updates = {}');
  Lines.Add('for index, (tag, repos) in enumerate(zip(tags, repositories)):');
  Lines.Add('    if not tag:');
  Lines.Add('        continue');
  Lines.Add('    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}", tag):');
  Lines.Add('        fail("Ungültiger Docker-Image-Tag.")');
  Lines.Add('    if index == 2 and not re.fullmatch(r"18(?:\.[0-9]+)*(?:-[A-Za-z0-9_.-]+)?", tag):');
  Lines.Add('        fail("Für dieses Projekt sind nur PostgreSQL-Tags der Hauptversion 18 zulässig.")');
  Lines.Add('    matched = False');
  Lines.Add('    for service, config in model["services"].items():');
  Lines.Add('        image = config.get("image", "")');
  Lines.Add('        repository = image.split("@", 1)[0]');
  Lines.Add('        if ":" in repository.rsplit("/", 1)[-1]:');
  Lines.Add('            repository = repository.rsplit(":", 1)[0]');
  Lines.Add('        normalized = repository.removeprefix("docker.io/").removeprefix("library/")');
  Lines.Add('        if normalized not in repos:');
  Lines.Add('            continue');
  Lines.Add('        if index == 2 and not re.fullmatch(r"18(?:\.[0-9]+)*(?:-[A-Za-z0-9_.-]+)?", image.split("@", 1)[0].rsplit(":", 1)[-1]):');
  Lines.Add('            fail("Der vorhandene PostgreSQL-Dienst verwendet keinen Tag der Hauptversion 18.")');
  Lines.Add('        matched = True');
  Lines.Add('        if image != repository + ":" + tag:');
  Lines.Add('            updates[service] = (image, repository + ":" + tag)');
  Lines.Add('    if not matched:');
  Lines.Add('        fail("Kein Compose-Dienst für " + repos[0] + " gefunden.")');
  Lines.Add('');
  Lines.Add('stage = work / "candidate.yml"');
  Lines.Add('# Edit only literal image values under the matching services. Validate the effective model separately.');
  Lines.Add('lines = stage.read_bytes().decode("utf-8-sig").splitlines(keepends=True)');
  Lines.Add('in_services = False');
  Lines.Add('service = None');
  Lines.Add('indent = None');
  Lines.Add('changed = set()');
  Lines.Add('for number, line in enumerate(lines):');
  Lines.Add('    body = line.rstrip("\r\n")');
  Lines.Add('    if not body.strip() or body.lstrip().startswith("#"):');
  Lines.Add('        continue');
  Lines.Add('    if not body.startswith(" "):');
  Lines.Add('        in_services = bool(re.fullmatch(r"services:\s*(?:#.*)?", body))');
  Lines.Add('        service = None');
  Lines.Add('        indent = None');
  Lines.Add('        continue');
  Lines.Add('    if not in_services:');
  Lines.Add('        continue');
  Lines.Add('    spaces = len(body) - len(body.lstrip(" "))');
  Lines.Add('    if indent is None:');
  Lines.Add('        indent = spaces');
  Lines.Add('    if spaces == indent:');
  Lines.Add('        key = re.fullmatch(r"\s*([A-Za-z0-9_.-]+):\s*(?:#.*)?", body)');
  Lines.Add('        service = key[1] if key else None');
  Lines.Add('        continue');
  Lines.Add('    if service not in updates:');
  Lines.Add('        continue');
  Lines.Add('    match = re.fullmatch(r"(\s*image:\s*)([''\"]?)([^''\" \t#]+)\2(\s*(?:#.*)?)", body)');
  Lines.Add('    if not match or match[3] != updates[service][0]:');
  Lines.Add('        continue');
  Lines.Add('    lines[number] = match[1] + match[2] + updates[service][1] + match[2] + match[4] + line[len(body):]');
  Lines.Add('    changed.add(service)');
