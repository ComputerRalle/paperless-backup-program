  Lines.Add('for service, (_, image) in updates.items():');
  Lines.Add('    model["services"][service]["image"] = image');
  Lines.Add('(work / "before.json").write_text(json.dumps(model), encoding="utf-8")');
  Lines.Add('PAPERLESS_TAGS');
  Lines.Add('dc "$stage" config --format json >"$work/after.json"');
  Lines.Add('python3 - "$work" <<''PAPERLESS_COMPARE''');
  Lines.Add('import json');
  Lines.Add('from pathlib import Path');
