    Lines.Add('');
    Lines.Add('def private_command(args, **kwargs):');
    Lines.Add('    return subprocess.check_output(args, stderr=subprocess.DEVNULL, **kwargs)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def compose_model(path, project):');
    Lines.Add('    args = ["docker", "compose", "-f", path]');
    Lines.Add('    if project:');
    Lines.Add('        args += ["-p", project]');
    Lines.Add('    return json.loads(private_command(args + ["config", "--format", "json"]))');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def container_key_state(web):');
    Lines.Add('    container = json.loads(private_command(["docker", "inspect", web]))[0]');
    Lines.Add('    env = dict(item.split("=", 1) for item in container["Config"]["Env"] if "=" in item)');
    Lines.Add('    return container, env');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def validate_target(model, container):');
    Lines.Add('    service = model["services"]["paperless"]');
    Lines.Add('    if service.get("image") != container["Config"]["Image"]:');
    Lines.Add('        raise ValueError("configured image differs from existing container")');
    Lines.Add('    mounts = {mount["Destination"]: mount for mount in container["Mounts"]}');
    Lines.Add('    volumes = {volume["target"]: volume for volume in service.get("volumes", [])}');
    Lines.Add('    for role in ("data", "media", "export"):');
    Lines.Add('        target = "/usr/src/paperless/" + role');
    Lines.Add('        desired, actual = volumes[target], mounts[target]');
    Lines.Add('        if desired["type"] == "volume":');
    Lines.Add('            volume = model["volumes"][desired["source"]]');
    Lines.Add('            matches = actual["Type"] == "volume" and volume["name"] == actual["Name"]');
    Lines.Add('        else:');
    Lines.Add('            matches = desired["type"] == actual["Type"] == "bind" and desired["source"] == actual["Source"]');
    Lines.Add('        if not matches or desired.get("read_only") or not actual["RW"]:');
    Lines.Add('            raise ValueError("configured mounts differ from existing container")');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def prepare_key(key_file, compose, candidate, project, web):');
    Lines.Add('    key = Path(key_file).read_text(encoding="utf-8")');
    Lines.Add('    original = compose_model(compose, project)');
    Lines.Add('    container, _ = container_key_state(web)');
    Lines.Add('    validate_target(original, container)');
    Lines.Add('    current = original["services"]["paperless"].get("environment", {})');
    Lines.Add('    if "$" not in key and current.get(KEY_NAME) == key and not current.get(KEY_FILE_NAME):');
    Lines.Add('        return');
    Lines.Add('');
    Lines.Add('    # yq updates the source YAML without rendering interpolated settings or env files.');
    Lines.Add('    environment = ".services.paperless.environment"');
    Lines.Add('    tag = private_command(["yq", "-r", environment + " | tag", compose]).decode().strip()');
    Lines.Add('    escaped = key.replace("$", "$$")');
    Lines.Add('    if tag == "!!seq":');
    Lines.Add('        expression = (');
    Lines.Add('            ''del('' + environment + ''[] | select(test("^PAPERLESS_SECRET_KEY(_FILE)?(=|$)"))) | ''');
    Lines.Add('            + environment + '' += [strenv(PAPERLESS_RESTORE_KEY), "PAPERLESS_SECRET_KEY_FILE="]''');
    Lines.Add('        )');
    Lines.Add('        value = KEY_NAME + "=" + escaped');
    Lines.Add('    elif tag in ("!!map", "!!null"):');
    Lines.Add('        expression = (');
    Lines.Add('            environment + ''.PAPERLESS_SECRET_KEY = strenv(PAPERLESS_RESTORE_KEY) | ''');
    Lines.Add('            + environment + ''.PAPERLESS_SECRET_KEY_FILE = ""''');
    Lines.Add('        )');
    Lines.Add('        value = escaped');
    Lines.Add('    else:');
    Lines.Add('        raise ValueError("unsupported environment format")');
    Lines.Add('    updated = private_command(["yq", expression, compose], env={**os.environ, "PAPERLESS_RESTORE_KEY": value})');
    Lines.Add('    Path(candidate).write_bytes(updated)');
    Lines.Add('');
    Lines.Add('    # Compare complete Compose models. Some versions re-escape literal dollars in config output.');
    Lines.Add('    rendered = compose_model(candidate, project)');
    Lines.Add('    selected = rendered["services"]["paperless"].get("environment", {})');
    Lines.Add('    if selected.get(KEY_NAME) not in (key, escaped) or selected.get(KEY_FILE_NAME):');
    Lines.Add('        raise ValueError("Compose did not apply the backup key")');
    Lines.Add('    for model in (original, rendered):');
    Lines.Add('        service = model["services"]["paperless"]');
    Lines.Add('        settings = service.pop("environment", {})');
    Lines.Add('        settings.pop(KEY_NAME, None)');
    Lines.Add('        settings.pop(KEY_FILE_NAME, None)');
    Lines.Add('        if settings:');
    Lines.Add('            service["environment"] = settings');
    Lines.Add('    if rendered != original:');
    Lines.Add('        raise ValueError("other effective Compose settings changed")');
    Lines.Add('    metadata = os.stat(compose)');
    Lines.Add('    os.chown(candidate, metadata.st_uid, metadata.st_gid)');
    Lines.Add('    os.chmod(candidate, stat.S_IMODE(metadata.st_mode))');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def verify_key(key_file, web):');
    Lines.Add('    key = Path(key_file).read_text(encoding="utf-8")');
    Lines.Add('    _, env = container_key_state(web)');
    Lines.Add('    if env.get(KEY_NAME) != key or env.get(KEY_FILE_NAME):');
    Lines.Add('        raise ValueError("Paperless is not configured with the selected key")');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('class DumpPreflightError(ValueError):');
    Lines.Add('    pass');
    Lines.Add('');
    Lines.Add('');
    // Track quotes and statement boundaries so backslashes in strings and END within CASE expressions pass the SQL check.
    // Anführungszeichen und Anweisungsgrenzen verfolgen, damit Backslashes in Zeichenketten und END in CASE-Ausdrücken die SQL-Prüfung passieren.
    Lines.Add('class DumpSqlScanner:');
    Lines.Add('    def __init__(self):');
    Lines.Add('        self.statement_start = True');
    Lines.Add('        self.quote = ""');
    Lines.Add('        self.comment_depth = 0');
    Lines.Add('');
    Lines.Add('    @property');
    Lines.Add('    def ready(self):');
    Lines.Add('        return self.statement_start and not self.quote and not self.comment_depth');
    Lines.Add('');
    Lines.Add('    def scan(self, text, line_number):');
    Lines.Add('        offset = 0');
    Lines.Add('        while offset < len(text):');
    Lines.Add('            if self.comment_depth:');
    Lines.Add('                comment = SQL_COMMENT.search(text, offset)');
    Lines.Add('                if not comment:');
    Lines.Add('                    return');
    Lines.Add('                self.comment_depth += 1 if comment[0] == "/*" else -1');
    Lines.Add('                offset = comment.end()');
    Lines.Add('                continue');
    Lines.Add('');
    Lines.Add('            if self.quote:');
    Lines.Add('                if self.quote == "E''":');
    Lines.Add('                    end = ESCAPED_STRING_TOKEN.search(text, offset)');
    Lines.Add('                    if not end:');
    Lines.Add('                        return');
    Lines.Add('                    offset = end.end()');
    Lines.Add('                    if end[0] != "''":');
    Lines.Add('                        continue');
    Lines.Add('                else:');
    Lines.Add('                    end = text.find(self.quote, offset)');
    Lines.Add('                    if end < 0:');
    Lines.Add('                        return');
    Lines.Add('                    offset = end + len(self.quote)');
    Lines.Add('                if self.quote in ("''", "E''", ''"'') and text.startswith(self.quote[-1], offset):');
    Lines.Add('                    offset += 1');
    Lines.Add('                else:');
    Lines.Add('                    self.quote = ""');
    Lines.Add('                continue');
    Lines.Add('');
    Lines.Add('            match = SQL_TOKEN.search(text, offset)');
    Lines.Add('            if not match or match[0] == "--":');
    Lines.Add('                return');
    Lines.Add('            token = match[0]');
    Lines.Add('            offset = match.end()');
    Lines.Add('            if token == "/*":');
    Lines.Add('                self.comment_depth = 1');
    Lines.Add('                continue');
    Lines.Add('            if token == "\\":');
    Lines.Add('                raise DumpPreflightError(f"Unerwarteter psql-Befehl in Zeile {line_number}.")');
    Lines.Add('            if self.statement_start and token.upper() in DUMP_CONTROL_COMMANDS:');
    Lines.Add('                raise DumpPreflightError(f"Unerwarteter SQL-Steuerbefehl in Zeile {line_number}.")');
    Lines.Add('            self.statement_start = token == ";"');
    Lines.Add('            if token in ("''", ''"'', "e''", "E''"):');
    Lines.Add('                self.quote = token.upper()');
    Lines.Add('            elif len(token) > 1 and token.startswith("$") and token.endswith("$"):');
    Lines.Add('                self.quote = token');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def require_dump_space(path, required, location):');
    Lines.Add('    free = shutil.disk_usage(path).free');
    Lines.Add('    if free < required:');
    Lines.Add('        mib = 1024**2');
    Lines.Add('        raise DumpPreflightError(');
    Lines.Add('            f"Zu wenig Platz {location}. Frei: {free / mib:.1f} MiB. Benoetigt: {required / mib:.1f} MiB."');
    Lines.Add('        )');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def prepare_dump(source, destination, db_mount):');
    Lines.Add('    with private_input(source) as raw:');
    Lines.Add('        size = os.fstat(raw.fileno()).st_size');
    Lines.Add('        require_dump_space(db_mount, 3 * size + 256 * 1024**2, "auf dem PostgreSQL-Datentraeger")');
    Lines.Add('        require_dump_space(Path(destination).parent, size + 16 * 1024**2, "fuer die temporaere SQL-Datei")');
    Lines.Add('        sql = DumpSqlScanner()');
    Lines.Add('        copied = False');
    Lines.Add('        copy_count = 0');
    Lines.Add('        ended = False');
    Lines.Add('        # Use our own restriction key. Dump-supplied framing is replaced below.');
    Lines.Add('        # Eigenen Sperrschluessel verwenden und die psql-Klammer des Dumps ersetzen.');
    Lines.Add('        restriction = secrets.token_hex(32)');
    Lines.Add('        with io.TextIOWrapper(raw, encoding="utf-8-sig") as dump, open(destination, "x", encoding="utf-8", newline="\n") as out:');
    Lines.Add('            out.write(f"\\restrict {restriction}\n")');
    Lines.Add('            for number, line in enumerate(dump, 1):');
    Lines.Add('                text = line.rstrip("\n")');
    Lines.Add('                if copied:');
    Lines.Add('                    copied = text != r"\."');
    Lines.Add('                elif sql.ready and COPY_HEADER.fullmatch(text):');
    Lines.Add('                    copied = True');
    Lines.Add('                    copy_count += 1');
    Lines.Add('                elif sql.ready and PSQL_FRAME.fullmatch(text):');
    Lines.Add('                    continue');
    Lines.Add('                elif sql.ready and text == "-- PostgreSQL database dump complete":');
    Lines.Add('                    ended = True');
    Lines.Add('                else:');
    Lines.Add('                    sql.scan(text, number)');
    Lines.Add('                out.write(line)');
    Lines.Add('            if copied or not copy_count or not ended or not sql.ready:');
    Lines.Add('                raise DumpPreflightError("Der PostgreSQL-Textdump ist unvollstaendig.")');
    Lines.Add('            out.write(f"\n\\unrestrict {restriction}\n")');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def report_dump_preflight(source, destination, db_mount):');
    Lines.Add('    try:');
    Lines.Add('        prepare_dump(source, destination, db_mount)');
    Lines.Add('    except DumpPreflightError as error:');
    Lines.Add('        print(f"SQL-Vorpruefung: {error}", file=sys.stderr)');
    Lines.Add('    except UnicodeError:');
    Lines.Add('        print("SQL-Vorpruefung: Der Dump ist kein gueltiger UTF-8-Text.", file=sys.stderr)');
    Lines.Add('    except OSError as error:');
    Lines.Add('        print(f"SQL-Vorpruefung: Datei- oder Speicherzugriff fehlgeschlagen (Systemfehler {error.errno}).", file=sys.stderr)');
    Lines.Add('    except ValueError:');
    Lines.Add('        print("SQL-Vorpruefung: Es wird eine lesbare PostgreSQL-Dumpdatei erwartet.", file=sys.stderr)');
    Lines.Add('    else:');
    Lines.Add('        return');
    Lines.Add('    sys.exit(1)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def work_dir(target, run):');
    Lines.Add('    name = ".paperless-restore-" + run');
    Lines.Add('    if not RESERVED.fullmatch(name):');
    Lines.Add('        raise ValueError("invalid restore run")');
    Lines.Add('    return Path(target) / name');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def check_mounts(target):');
    Lines.Add('    nested = str(Path(target)) + "/"');
    Lines.Add('    with open("/proc/self/mountinfo", encoding="utf-8") as mounts:');
    Lines.Add('        for row in mounts:');
    Lines.Add('            mount = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), row.split()[4])');
    Lines.Add('            if mount.startswith(nested):');
    Lines.Add('                raise ValueError("nested mount at restore target")');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def stage_archive(archive_path, target, run, filesystem, role):');
    Lines.Add('    check_mounts(target)');
    Lines.Add('    work = work_dir(target, run)');
    Lines.Add('    work.mkdir(mode=0o700)');
    Lines.Add('    replacement = work / "new"');
    Lines.Add('    replacement.mkdir()');
    Lines.Add('    (work / "old").mkdir()');
    Lines.Add('    space = shutil.disk_usage(target).free - 16 * 1024**2');
    Lines.Add('    seen = set()');
    Lines.Add('    directory_metadata = []');
    Lines.Add('    preserve_owner = filesystem not in {"cifs", "smb3", "smbfs"}');
    // Report the extracted size in MiB about every eight seconds during archive extraction.
    // Beim Entpacken etwa alle acht Sekunden die bereits entpackte Größe in MiB melden.
    Lines.Add('    staged_bytes = 0');
    Lines.Add('    next_progress = time.monotonic() + 8');
    Lines.Add('');
    Lines.Add('    def apply_metadata(path, member):');
    Lines.Add('        if preserve_owner:');
    Lines.Add('            os.chown(path, member.uid, member.gid)');
    Lines.Add('        os.chmod(path, member.mode & 0o777)');
    Lines.Add('        os.utime(path, (member.mtime, member.mtime))');
    Lines.Add('');
    Lines.Add('    with private_input(archive_path) as raw, tarfile.open(fileobj=raw, mode="r|gz") as archive:');
    Lines.Add('        for member in archive:');
    Lines.Add('            path = PurePosixPath(member.name)');
    Lines.Add('            if path.is_absolute() or ".." in path.parts or "\\" in member.name:');
    Lines.Add('                raise ValueError("archive path leaves the target")');
    Lines.Add('            if not path.parts and member.isdir():');
    Lines.Add('                continue');
    Lines.Add('            if not path.parts or RESERVED.fullmatch(path.parts[0]) or path in seen:');
    Lines.Add('                raise ValueError("invalid or repeated archive path")');
    Lines.Add('            seen.add(path)');
    Lines.Add('            location = replacement.joinpath(*path.parts)');
    Lines.Add('            if member.isdir():');
    Lines.Add('                location.mkdir(parents=True, exist_ok=True)');
    Lines.Add('                directory_metadata.append((location, member))');
    Lines.Add('            elif member.isreg():');
    Lines.Add('                space -= member.size');
    Lines.Add('                if space < 0:');
    Lines.Add('                    raise ValueError("not enough space in the target mount")');
    Lines.Add('                location.parent.mkdir(parents=True, exist_ok=True)');
    Lines.Add('                with archive.extractfile(member) as source, location.open("xb") as output:');
    Lines.Add('                    while block := source.read(1024**2):');
    Lines.Add('                        output.write(block)');
    Lines.Add('                        staged_bytes += len(block)');
    Lines.Add('                        now = time.monotonic()');
    Lines.Add('                        if now >= next_progress:');
    Lines.Add('                            print(f"Archiv {role}: {staged_bytes // 1024**2} MiB vorbereitet", flush=True)');
    Lines.Add('                            next_progress = now + 8');
    Lines.Add('                apply_metadata(location, member)');
    Lines.Add('            else:');
    Lines.Add('                raise ValueError("archive contains a link or special file")');
    Lines.Add('    for location, member in reversed(directory_metadata):');
    Lines.Add('        apply_metadata(location, member)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def report_archive(archive_path, target, run, filesystem, role):');
    Lines.Add('    try:');
    Lines.Add('        stage_archive(archive_path, target, run, filesystem, role)');
    Lines.Add('    except (tarfile.TarError, EOFError):');
    Lines.Add('        print(f"Archiv {role}: beschädigtes oder unlesbares TAR-Archiv.", file=sys.stderr)');
    Lines.Add('    except OSError as error:');
    Lines.Add('        print(f"Archiv {role}: Datei- oder Speicherzugriff fehlgeschlagen (Systemfehler {error.errno}).", file=sys.stderr)');
    Lines.Add('    except ValueError as error:');
    Lines.Add('        reasons = {');
    Lines.Add('            "archive path leaves the target": "Pfad liegt außerhalb des Zielordners",');
    Lines.Add('            "invalid or repeated archive path": "ungültiger oder doppelter Archivpfad",');
    Lines.Add('            "not enough space in the target mount": "zu wenig Speicher im Ziel-Mount",');
    Lines.Add('            "archive contains a link or special file": "Verknüpfung oder Spezialdatei im Archiv",');
    Lines.Add('            "nested mount at restore target": "verschachtelter Mount im Zielordner",');
    Lines.Add('        }');
    Lines.Add('        print(f"Archiv {role}: {reasons.get(str(error), ''ungültiger Archiveintrag'')}.", file=sys.stderr)');
    Lines.Add('    else:');
    Lines.Add('        return');
    Lines.Add('    sys.exit(1)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def replace_files(target, run):');
    Lines.Add('    check_mounts(target)');
    Lines.Add('    work = work_dir(target, run)');
    Lines.Add('    if work.is_symlink() or not work.is_dir():');
    Lines.Add('        raise ValueError("invalid working directory")');
    Lines.Add('    old = work / "old"');
    Lines.Add('    new = work / "new"');
    Lines.Add('    for entry in Path(target).iterdir():');
    Lines.Add('        if not RESERVED.fullmatch(entry.name):');
    Lines.Add('            entry.rename(old / entry.name)');
    Lines.Add('    (work / "originals-moved").touch(exist_ok=False)');
    Lines.Add('    for entry in new.iterdir():');
    Lines.Add('        entry.rename(Path(target) / entry.name)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def rollback_files(target, run):');
    Lines.Add('    check_mounts(target)');
    Lines.Add('    work = work_dir(target, run)');
    Lines.Add('    if work.is_symlink() or not work.is_dir():');
    Lines.Add('        raise ValueError("invalid working directory")');
    Lines.Add('    old = work / "old"');
    Lines.Add('    new = work / "new"');
    Lines.Add('    if (work / "originals-moved").is_file() and not (work / "new-cleared").is_file():');
    Lines.Add('        for entry in Path(target).iterdir():');
    Lines.Add('            if not RESERVED.fullmatch(entry.name):');
    Lines.Add('                entry.rename(new / entry.name)');
    Lines.Add('        (work / "new-cleared").touch(exist_ok=False)');
    Lines.Add('    for entry in old.iterdir():');
    Lines.Add('        entry.rename(Path(target) / entry.name)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def clean(target, run):');
    Lines.Add('    check_mounts(target)');
    Lines.Add('    work = work_dir(target, run)');
    Lines.Add('    if work.exists() and work.is_dir() and not work.is_symlink():');
    Lines.Add('        shutil.rmtree(work)');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('commands = {');
    Lines.Add('    "key-read": save_selected_key,');
    Lines.Add('    "key-prepare": prepare_key,');
    Lines.Add('    "key-publish": os.replace,');
    Lines.Add('    "key-verify": verify_key,');
    Lines.Add('    "dump": report_dump_preflight,');
    Lines.Add('    "stage": report_archive,');
    Lines.Add('    "replace": replace_files,');
    Lines.Add('    "rollback": rollback_files,');
    Lines.Add('    "clean": clean,');
    Lines.Add('}');
    Lines.Add('commands[sys.argv[1]](*sys.argv[2:])');
    Lines.Add('PAPERLESS_RESTORE_FILES');
    Lines.Add('image_hash=$(sha256sum "$build_dir/worker.sh" "$build_dir/restore_files.py" "$build_dir/Dockerfile" | awk ''{print $1}'' | sha256sum)');
    Lines.Add('image="paperless-restore-pg18:${image_hash%% *}"');
    Lines.Add('if ! docker image inspect "$image" >/dev/null 2>&1; then');
    Lines.Add('  docker build -q -t "$image" "$build_dir" >/dev/null 2>&1');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('stage=''Docker-Container fuer die Wiederherstellung starten''');
    Lines.Add('if [ -n "$old" ]; then docker rm "$old" >/dev/null 2>&1; fi');
    Lines.Add('id=$(docker run --detach --name "$job" --restart=no --network none --stop-timeout 240 --log-driver local \');
    Lines.Add('  --label de.computerralle.paperless.restore=pg18 \');
    Lines.Add('  --label "de.computerralle.paperless.restore.profile=$profile" \');
    Lines.Add('  --label "de.computerralle.paperless.restore.selection=$selection_hash" \');
    Lines.Add('  --label de.computerralle.paperless.maintenance=flock-v1 \');
    Lines.Add('  --mount "type=bind,src=$socket,dst=/var/run/docker.sock" \');
    Lines.Add('  --mount "type=bind,src=$compose_dir,dst=$compose_dir" \');
    Lines.Add('  --mount "type=bind,src=$target,dst=/backup,readonly" \');
    Lines.Add('  --mount "type=bind,src=$data,dst=/target-data" \');
    Lines.Add('  --mount "type=bind,src=$media,dst=/target-media" \');
    Lines.Add('  --mount "type=bind,src=$export_dir,dst=/target-export" \');
    Lines.Add('  --mount "type=bind,src=$dbdata,dst=/dbspace,readonly" \');
    Lines.Add('  --mount type=volume,src=paperless-pg18-operation-lock,dst=/operation-lock \');
    Lines.Add('  "$image" "$web" "$db" "$compose" "$project" "$stamp" "$selected" "$run" "$prefix" 2>/dev/null)');
    Lines.Add('case "$id" in ''''|*[!a-f0-9]*) exit 1;; esac');
    Lines.Add('[ "${#id}" -eq 64 ]');
    Lines.Add('printf ''OK: %s\n'' "$id"');
    Result := StringReplace(Lines.Text, sLineBreak, #10, [rfReplaceAll]);
  finally
    Lines.Free;
  end;
end;
