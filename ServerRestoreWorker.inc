    Lines.Add('def private_input(path):');
    Lines.Add('    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)');
    Lines.Add('    if not stat.S_ISREG(os.fstat(fd).st_mode):');
    Lines.Add('        os.close(fd)');
    Lines.Add('        raise ValueError("not a regular file")');
    Lines.Add('    return os.fdopen(fd, "rb")');
