    // Bei fehlendem oder leerem Schlüssel den eingebauten Legacy-Wert verwenden. Ungültige Schlüsseldateien brechen die Vorprüfung ab.
    Lines.Add('def read_key(path):');
    Lines.Add('    try:');
    Lines.Add('        with private_input(path) as source:');
    Lines.Add('            raw = source.read(65537)');
    Lines.Add('    except FileNotFoundError:');
    Lines.Add('        return LEGACY_KEY, "Legacy"');
    Lines.Add('    recorded = raw.decode("utf-8-sig").rstrip("\r\n")');
    Lines.Add('    prefix = KEY_NAME + "="');
    Lines.Add('    if not recorded.strip():');
    Lines.Add('        return LEGACY_KEY, "Legacy"');
    Lines.Add('    if len(raw) > 65536 or not recorded.startswith(prefix) or any(c in recorded for c in "\r\n\0"):');
    Lines.Add('        raise ValueError("invalid backup key")');
    Lines.Add('    key = recorded[len(prefix):]');
    Lines.Add('    return (key, "Backup") if key.strip() else (LEGACY_KEY, "Legacy")');
    Lines.Add('');
    Lines.Add('');
    Lines.Add('def save_selected_key(backup, key_file):');
