// Embed the Linux launcher and detached restore worker in the Windows program.
// Linux-Starter und getrennten Wiederherstellungscontainer in das Windows-Programm einbetten.
function ServerRestoreLaunchScript: string;
var
  Lines: TStringList;
  KeyByte: Byte;
  LegacyKeyHex: string;
begin
  Lines := TStringList.Create;
  try
    Lines.Add('set -eu');
    Lines.Add('umask 077');
    Lines.Add('stage=''Docker-Verbindung pruefen''');
    Lines.Add('build_dir=');
    Lines.Add('finish_launch() {');
    Lines.Add('  rc=$?');
    Lines.Add('  trap - EXIT');
    Lines.Add('  if [ -n "$build_dir" ]; then');
    Lines.Add('    rm -f -- "$build_dir/Dockerfile" "$build_dir/worker.sh" "$build_dir/restore_files.py"');
    Lines.Add('    rmdir -- "$build_dir" || :');
    Lines.Add('  fi');
    Lines.Add('  if [ "$rc" -ne 0 ]; then printf ''ERROR: %s (Exitcode %s).\n'' "$stage" "$rc"; fi');
    Lines.Add('  exit 0');
    Lines.Add('}');
    Lines.Add('trap finish_launch EXIT');
    Lines.Add('trap ''exit 1'' HUP INT TERM');
    Lines.Add('socket=/var/run/docker.sock');
    Lines.Add('[ -S "$socket" ]');
    Lines.Add('case "${DOCKER_HOST:-unix://$socket}" in "unix://$socket") ;; *) exit 1;; esac');
    Lines.Add('[ "$(docker context inspect --format ''{{.Endpoints.docker.Host}}'' 2>/dev/null)" = "unix://$socket" ]');
    Lines.Add('docker info >/dev/null 2>&1');
    Lines.Add('profile=$(printf ''%s\n%s\n'' "$compose" "$project" | sha256sum)');
    Lines.Add('profile=${profile%% *}');
    Lines.Add('');
    Lines.Add('stage=''Gespeicherten Backupordner und Auswahl pruefen''');
    Lines.Add('target=$(realpath -e -- "$target")');
    Lines.Add('[ "$target" != / ] && [ -d "$target" ]');
    Lines.Add('stamp=${selected##*/}');
    Lines.Add('case "$stamp" in');
    Lines.Add('  [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;');
    Lines.Add('  *) exit 1;;');
    Lines.Add('esac');
    Lines.Add('[ "$selected" = "$target/$stamp" ] && [ -d "$selected" ] && [ ! -L "$selected" ]');
    Lines.Add('[ "$(realpath -e -- "$selected")" = "$selected" ]');
    Lines.Add('selection_hash=$(printf ''%s\n'' "$selected" | sha256sum)');
    Lines.Add('selection_hash=${selection_hash%% *}');
    Lines.Add('for file in "${prefix}-db-1_backup.sql" "${prefix}_data.tar.gz" "${prefix}_media.tar.gz" "${prefix}_export.tar.gz"; do');
    Lines.Add('  [ -f "$selected/$file" ] && [ -r "$selected/$file" ] && [ -s "$selected/$file" ] && [ ! -L "$selected/$file" ] || exit 1');
    Lines.Add('done');
    Lines.Add('case "$run" in ''''|*[!0-9a-fA-F-]*) exit 1;; esac');
    Lines.Add('');
    // Reattach to an active worker only when its Compose profile and selected backup match.
    // Einen laufenden Worker nur bei übereinstimmendem Compose-Profil und ausgewähltem Backup wiederverwenden.
    Lines.Add('stage=''Vorhandene Wiederherstellung pruefen''');
    Lines.Add('old=$(docker ps -aq --no-trunc --filter "name=^/$job$" 2>/dev/null)');
    Lines.Add('inspect_restore() {');
    Lines.Add('  docker inspect --format ''{{index .Config.Labels "de.computerralle.paperless.restore"}}:{{index .Config.Labels "de.computerralle.paperless.restore.profile"}}:{{index .Config.Labels "de.computerralle.paperless.restore.selection"}}:{{.State.Status}}'' "$1" 2>/dev/null');
    Lines.Add('}');
    Lines.Add('if [ -n "$old" ]; then');
    Lines.Add('  previous=$(inspect_restore "$old")');
    Lines.Add('  case "$previous" in');
    Lines.Add('    pg18:*:running|pg18:*:restarting|pg18:*:paused)');
    Lines.Add('      case "$previous" in');
    Lines.Add('        "pg18:$profile:$selection_hash:"*) printf ''OK: %s\n'' "$old"; exit 0;;');
    Lines.Add('        *) stage=''Eine andere Server-Wiederherstellung laeuft bereits''; exit 1;;');
    Lines.Add('      esac');
    Lines.Add('      ;;');
    Lines.Add('    pg18:*:exited|pg18:*:created|pg18:*:dead) ;;');
    Lines.Add('    *) exit 1;;');
    Lines.Add('  esac');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('stage=''Compose-Dienste und PostgreSQL 18 ermitteln''');
    Lines.Add('compose=$(realpath -e -- "$compose")');
    Lines.Add('compose_dir=${compose%/*}');
    Lines.Add('[ -f "$compose" ] && [ -r "$compose" ] && [ -n "$compose_dir" ]');
    Lines.Add('case "$compose_dir" in /|/var/run|/var/run/*|/run|/run/*|/backup|/backup/*|/operation-lock|/operation-lock/*|/restore|/restore/*|/target-*|/dbspace|/dbspace/*) exit 1;; esac');
    Lines.Add('cd -- "$compose_dir"');
    Lines.Add('compose_cmd() {');
    Lines.Add('  if [ -n "$project" ]; then docker compose -f "$compose" -p "$project" "$@"');
    Lines.Add('  else docker compose -f "$compose" "$@"; fi');
    Lines.Add('}');
    Lines.Add('web=$(compose_cmd ps -a -q paperless 2>/dev/null)');
    Lines.Add('db=$(compose_cmd ps -a -q db 2>/dev/null)');
    Lines.Add('for id in "$web" "$db"; do case "$id" in ''''|*[!a-f0-9]*) exit 1;; esac; done');
    Lines.Add('[ "$web" != "$db" ]');
    Lines.Add('version=$(docker exec "$db" postgres --version 2>/dev/null)');
    Lines.Add('case "$version" in ''postgres (PostgreSQL) 18.''*) ;; *) exit 1;; esac');
    Lines.Add('');
    Lines.Add('stage=''Schreibbare Docker-Mounts fuer data, media und export ermitteln''');
    Lines.Add('mount_source() {');
    Lines.Add('  path=$(docker inspect --format "{{range .Mounts}}{{if and .RW (eq .Destination \"$2\")}}{{println .Source}}{{end}}{{end}}" "$1" 2>/dev/null) || return 1');
    Lines.Add('  case "$path" in /*) ;; *) return 1;; esac');
    Lines.Add('  [ -n "$path" ] && [ -d "$path" ] || return 1');
    Lines.Add('  realpath -e -- "$path"');
    Lines.Add('}');
    Lines.Add('data=$(mount_source "$web" /usr/src/paperless/data)');
    Lines.Add('media=$(mount_source "$web" /usr/src/paperless/media)');
    Lines.Add('export_dir=$(mount_source "$web" /usr/src/paperless/export)');
    Lines.Add('dbdata=$(mount_source "$db" /var/lib/postgresql)');
    Lines.Add('mount_path() {');
    Lines.Add('  case "$1" in /|*,*|*\"*|*''');
    Lines.Add('''*) return 1;; esac');
    Lines.Add('}');
    Lines.Add('for source in "$compose_dir" "$target" "$data" "$media" "$export_dir" "$dbdata"; do mount_path "$source" || exit 1; done');
    Lines.Add('disjoint() {');
    Lines.Add('  case "$1/" in "$2/"*) return 1;; esac');
    Lines.Add('  case "$2/" in "$1/"*) return 1;; esac');
    Lines.Add('}');
    Lines.Add('for source in "$data" "$media" "$export_dir" "$dbdata"; do');
    Lines.Add('  disjoint "$source" "$target" || exit 1');
    Lines.Add('  case "$compose_dir/" in "$source/"*) exit 1;; esac');
    Lines.Add('  case "$source" in');
    Lines.Add('    /mnt/*)');
    Lines.Add('      source_mount=$(findmnt -n -o TARGET --target "$source")');
    Lines.Add('      case "$source_mount" in /mnt|/mnt/*) ;; *) stage=''Mount unter /mnt ist nicht eingehaengt''; exit 1;; esac');
    Lines.Add('      ;;');
    Lines.Add('  esac');
    Lines.Add('done');
    Lines.Add('disjoint "$data" "$media" && disjoint "$data" "$export_dir" && disjoint "$media" "$export_dir" &&');
    Lines.Add('  disjoint "$data" "$dbdata" && disjoint "$media" "$dbdata" && disjoint "$export_dir" "$dbdata"');
    Lines.Add('');
    Lines.Add('stage=''Docker-Image fuer die Wiederherstellung bereitstellen''');
    Lines.Add('build_dir=$(mktemp -d)');
    Lines.Add('cat > "$build_dir/Dockerfile" <<''PAPERLESS_DOCKERFILE''');
    Lines.Add('FROM docker:cli');
    Lines.Add('RUN apk add --no-cache python3 util-linux yq-go');
    Lines.Add('COPY worker.sh restore_files.py /restore/');
    Lines.Add('RUN /bin/sh -n /restore/worker.sh && python3 -m py_compile /restore/restore_files.py');
    Lines.Add('ENTRYPOINT ["/bin/sh", "/restore/worker.sh"]');
    Lines.Add('PAPERLESS_DOCKERFILE');
    Lines.Add('cat > "$build_dir/worker.sh" <<''PAPERLESS_RESTORE_WORKER''');
    Lines.Add('#!/bin/sh');
    Lines.Add('set -eu');
    Lines.Add('umask 077');
    Lines.Add('web=$1');
    Lines.Add('db=$2');
    Lines.Add('compose=$3');
    Lines.Add('project=$4');
    Lines.Add('stamp=$5');
    Lines.Add('selected=$6');
    Lines.Add('run=$7');
    Lines.Add('prefix=$8');
    Lines.Add('backup="/backup/$stamp"');
    Lines.Add('stage=''Wiederherstellung vorbereiten''');
    Lines.Add('changed=0');
    Lines.Add('finished=0');
    Lines.Add('stopped_here=0');
    Lines.Add('recreating=0');
    Lines.Add('candidate=');
    Lines.Add('recovery=');
    Lines.Add('published_hash=');
    Lines.Add('db_changed=0');
    Lines.Add('rollback_db_supported=0');
    Lines.Add('key_file=/dev/shm/paperless-restore.key');
    AddServerPaperlessReadyCheck(Lines);
    // Keep a database checkpoint and the original Compose file outside the restored mounts.
    // Datenbanksicherung und ursprüngliche Compose-Datei außerhalb der Restore-Mounts aufbewahren.
    Lines.Add('db_command() {');
    Lines.Add('  docker exec -i --user postgres "$db" sh -c ''');
    Lines.Add('    if [ -n "${POSTGRES_PASSWORD:-}" ]; then export PGPASSWORD="$POSTGRES_PASSWORD"');
    Lines.Add('    elif [ -n "${POSTGRES_PASSWORD_FILE:-}" ]; then PGPASSWORD=$(cat -- "$POSTGRES_PASSWORD_FILE") || exit 1; export PGPASSWORD; fi');
    Lines.Add('    tool=$1; shift');
    Lines.Add('    exec "$tool" -w -U "${POSTGRES_USER:-paperless}" -d "${POSTGRES_DB:-paperless}" "$@"');
    Lines.Add('  '' sh "$@"');
    Lines.Add('}');
    Lines.Add('db_psql() { db_command psql -X -v ON_ERROR_STOP=1 -v VERBOSITY=sqlstate -v SHOW_CONTEXT=never "$@"; }');
    Lines.Add('clean_recovery() {');
    Lines.Add('  [ -n "$recovery" ] || return 0');
    Lines.Add('  rm -f -- "$recovery/database.original.dump" "$recovery/compose.original" "$recovery/compose.rollback" "$recovery/rollback.sql" "$recovery/sql.error" || return 1');
    Lines.Add('  rmdir -- "$recovery"');
    Lines.Add('}');
    Lines.Add('rollback_restore() {');
    Lines.Add('  current_hash=$(sha256sum <"$compose") || return 1');
    Lines.Add('  if [ "$current_hash" != "$compose_hash" ]; then [ -n "$published_hash" ] && [ "$current_hash" = "$published_hash" ] || return 1; fi');
    Lines.Add('  compose_cmd stop -t 90 paperless >/dev/null 2>&1 || return 1');
    Lines.Add('  if [ "$db_changed" -eq 1 ]; then');
    Lines.Add('    if [ "$rollback_db_supported" -ne 1 ]; then');
    Lines.Add('      printf "%s\n" "Datenbank enthält zusätzliche Schemas. Eine automatische Rücksicherung wurde nicht durchgeführt."');
    Lines.Add('      return 1');
    Lines.Add('    fi');
    Lines.Add('    docker exec -i --user postgres "$db" pg_restore --file=- <"$recovery/database.original.dump" >"$recovery/rollback.sql" 2>/dev/null || return 1');
    Lines.Add('    reset="DROP SCHEMA IF EXISTS public CASCADE;"');
    Lines.Add('    if ! grep -Eq ''^CREATE SCHEMA (public|"public");$'' "$recovery/rollback.sql"; then reset="$reset CREATE SCHEMA public AUTHORIZATION pg_database_owner; GRANT USAGE ON SCHEMA public TO PUBLIC;"; fi');
    Lines.Add('    db_psql -q -1 -c "$reset" -f - <"$recovery/rollback.sql" >/dev/null 2>&1 || return 1');
    Lines.Add('  fi');
    Lines.Add('  for role in data media export; do');
    Lines.Add('    python3 /restore/restore_files.py rollback "/target-$role" "$run" >/dev/null 2>&1 || return 1');
    Lines.Add('  done');
    Lines.Add('  if [ -n "$published_hash" ]; then');
    Lines.Add('    current_hash=$(sha256sum <"$compose") || return 1');
    Lines.Add('    if [ "$current_hash" != "$compose_hash" ]; then');
    Lines.Add('      [ "$current_hash" = "$published_hash" ] || return 1');
    Lines.Add('      cp -p -- "$recovery/compose.original" "$recovery/compose.rollback" || return 1');
    Lines.Add('      mv -fT -- "$recovery/compose.rollback" "$compose" || return 1');
    Lines.Add('    fi');
    Lines.Add('  fi');
    Lines.Add('  if [ "$recreating" -eq 1 ]; then');
    Lines.Add('    compose_cmd up --no-start --no-deps --pull never --force-recreate paperless >/dev/null 2>&1 || return 1');
    Lines.Add('    web=$(compose_cmd ps -a -q paperless 2>/dev/null) || return 1');
    Lines.Add('    [ -n "$web" ] || return 1');
    Lines.Add('  fi');
    Lines.Add('  if [ "$stopped_here" -eq 1 ]; then');
    Lines.Add('    docker start "$web" >/dev/null 2>&1 && wait_paperless "$web" || return 1');
    Lines.Add('  fi');
    Lines.Add('}');
    Lines.Add('fail_or_cleanup() {');
    Lines.Add('  rc=$?');
    Lines.Add('  trap - EXIT');
    Lines.Add('  trap '''' HUP INT TERM');
    Lines.Add('  rm -f -- "$key_file" /restore/restore.sql || :');
    Lines.Add('  if [ -n "$candidate" ]; then rm -f -- "$candidate" || :; fi');
    Lines.Add('  if [ "$rc" -ne 0 ]; then');
    Lines.Add('    printf ''FEHLER: %s.\n'' "$stage"');
    Lines.Add('    if [ "$changed" -eq 1 ] && [ "$finished" -eq 0 ]; then');
    Lines.Add('      if rollback_restore; then');
    Lines.Add('        changed=0');
    Lines.Add('        printf "%s\n" "Der vorherige Stand wurde wiederhergestellt."');
    Lines.Add('      else');
    Lines.Add('        compose_cmd stop -t 90 paperless >/dev/null 2>&1 ||');
    Lines.Add('          printf "%s\n" "Paperless konnte nach dem Fehler nicht sicher gestoppt werden."');
    Lines.Add('        printf ''Rücksicherung unvollständig. Datenbank und Compose liegen in %s. Datei-Arbeitsordner: .paperless-restore-%s.\n'' "$recovery" "$run"');
    Lines.Add('      fi');
    Lines.Add('    elif [ "$stopped_here" -eq 1 ]; then');
    Lines.Add('      if ! docker start "$web" >/dev/null 2>&1 || ! wait_paperless "$web"; then');
    Lines.Add('        printf "%s\n" "Paperless antwortet nach dem Abbruch nicht."');
    Lines.Add('      fi');
    Lines.Add('    fi');
    Lines.Add('  fi');
    Lines.Add('  if [ "$changed" -eq 0 ] || [ "$finished" -eq 1 ]; then');
    Lines.Add('    for role in data media export; do');
    Lines.Add('      if ! python3 /restore/restore_files.py clean "/target-$role" "$run" >/dev/null 2>&1; then');
    Lines.Add('        printf ''Hinweis: Arbeitsordner .paperless-restore-%s für %s konnte nicht entfernt werden.\n'' "$run" "$role"');
    Lines.Add('      fi');
    Lines.Add('    done');
    Lines.Add('    clean_recovery || printf ''Hinweis: Rücksicherungsdateien liegen noch in %s.\n'' "$recovery"');
    Lines.Add('  fi');
    Lines.Add('  if [ "$rc" -eq 0 ] && [ "$finished" -eq 1 ]; then');
    Lines.Add('    printf ''Wiederherstellung abgeschlossen: %s\n'' "$selected"');
    Lines.Add('  fi');
    Lines.Add('  exit "$rc"');
    Lines.Add('}');
    Lines.Add('progress() {');
    Lines.Add('  stage=$1');
    Lines.Add('  printf ''%s\n'' "$stage"');
    Lines.Add('}');
    Lines.Add('compose_cmd() {');
    Lines.Add('  if [ -n "$project" ]; then docker compose -f "$compose" -p "$project" "$@"');
    Lines.Add('  else docker compose -f "$compose" "$@"; fi');
    Lines.Add('}');
    Lines.Add('compose_restore() {');
    Lines.Add('  config=$compose');
    Lines.Add('  if [ -s "$candidate" ]; then config=$candidate; fi');
    Lines.Add('  if [ -n "$project" ]; then docker compose -f "$config" -p "$project" "$@"');
    Lines.Add('  else docker compose -f "$config" "$@"; fi');
    Lines.Add('}');
    Lines.Add('');
    Lines.Add('# Hold the same daemon-side lock as the backup worker throughout this operation.');
    Lines.Add('# Dieselbe Docker-Sperre wie der Backupcontainer bis zum Ende des Vorgangs halten.');
    Lines.Add('progress ''Andere Server-Sicherung oder Wiederherstellung pruefen''');
    Lines.Add('exec 9>>/operation-lock/job.lock');
    Lines.Add('if ! flock -n 9; then printf ''%s\n'' ''FEHLER: Eine Server-Sicherung oder Wiederherstellung laeuft bereits.''; exit 1; fi');
    Lines.Add('old_backup=$(docker ps -q --no-trunc --filter ''name=^/paperless-pg18-backup-job$'')');
    Lines.Add('if [ -n "$old_backup" ]; then');
    Lines.Add('  lock_version=$(docker inspect --format ''{{index .Config.Labels "de.computerralle.paperless.maintenance"}}'' "$old_backup")');
    Lines.Add('  [ "$lock_version" = flock-v1 ] || { printf ''%s\n'' ''FEHLER: Eine Sicherung ohne gemeinsame Sperre laeuft bereits.''; exit 1; }');
    Lines.Add('fi');
    Lines.Add('trap fail_or_cleanup EXIT');
    Lines.Add('trap ''exit 1'' HUP INT TERM');
    Lines.Add('');
    Lines.Add('progress ''Compose-Konfiguration und Docker-Dienste pruefen''');
    Lines.Add('cd -- "${compose%/*}"');
    Lines.Add('compose_cmd config --quiet >/dev/null 2>&1');
    Lines.Add('[ "$(compose_cmd ps -a -q paperless 2>/dev/null)" = "$web" ]');
    Lines.Add('[ "$(compose_cmd ps -a -q db 2>/dev/null)" = "$db" ]');
    Lines.Add('version=$(docker exec "$db" postgres --version 2>/dev/null)');
    Lines.Add('case "$version" in ''postgres (PostgreSQL) 18.''*) ;; *) exit 1;; esac');
    Lines.Add('web_state=$(docker inspect --format ''{{.State.Status}}'' "$web" 2>/dev/null)');
    Lines.Add('case "$web_state" in running|exited|created) ;; *) exit 1;; esac');
    Lines.Add('[ -d "$backup" ] && [ ! -L "$backup" ]');
    Lines.Add('for file in "${prefix}-db-1_backup.sql" "${prefix}_data.tar.gz" "${prefix}_media.tar.gz" "${prefix}_export.tar.gz"; do');
    Lines.Add('  [ -f "$backup/$file" ] && [ -s "$backup/$file" ] && [ ! -L "$backup/$file" ] || exit 1');
    Lines.Add('done');
    Lines.Add('');
    Lines.Add('# Keep the backup key on the server and validate the candidate before stopping Paperless.');
    Lines.Add('# Backup-Schluessel auf dem Server halten und die Compose-Kopie vor dem Stopp pruefen.');
    Lines.Add('progress ''Paperless-Schluessel aus dem Backup lesen''');
    Lines.Add('key_source=$(python3 /restore/restore_files.py key-read "$backup/paperless_secret_key.txt" "$key_file" 2>/dev/null)');
    Lines.Add('progress "Serverkonfiguration mit Paperless-Schluessel vorbereiten ($key_source)"');
    Lines.Add('compose_hash=$(sha256sum < "$compose")');
    Lines.Add('candidate=$(mktemp "${compose%/*}/.paperless-restore-$run.XXXXXX")');
    Lines.Add('python3 /restore/restore_files.py key-prepare "$key_file" "$compose" "$candidate" "$project" "$web" >/dev/null 2>&1');
    Lines.Add('');
    // Check the SQL dump and extract the three archives into staging directories before stopping Paperless.
    // SQL-Dump prüfen und die drei Archive in Arbeitsordner entpacken, bevor Paperless gestoppt wird.
    Lines.Add('progress ''PostgreSQL-Dump und Speicherplatz pruefen''');
    Lines.Add('dump="$backup/${prefix}-db-1_backup.sql"');
    Lines.Add('python3 /restore/restore_files.py dump "$dump" /restore/restore.sql /dbspace');
    Lines.Add('for role in data media export; do');
    Lines.Add('  progress "Archiv $role pruefen und im Ziel-Mount vorbereiten"');
    Lines.Add('  filesystem=$(findmnt -n -o FSTYPE --target "/target-$role")');
    Lines.Add('  python3 /restore/restore_files.py stage "$backup/${prefix}_$role.tar.gz" "/target-$role" "$run" "$filesystem" "$role"');
    Lines.Add('done');
    Lines.Add('');
    Lines.Add('progress ''Paperless fuer die Wiederherstellung stoppen''');
    Lines.Add('[ "$(sha256sum < "$compose")" = "$compose_hash" ]');
    Lines.Add('[ "$(docker inspect --format ''{{.State.Status}}'' "$web" 2>/dev/null)" = "$web_state" ]');
    Lines.Add('if [ "$web_state" = running ]; then');
    Lines.Add('  stopped_here=1');
    Lines.Add('  docker stop -t 90 "$web" >/dev/null 2>&1');
    Lines.Add('  stopped=$(docker inspect --format ''{{.State.Running}}:{{.State.ExitCode}}'' "$web" 2>/dev/null)');
    Lines.Add('  case "$stopped" in false:137) exit 1;; false:*) ;; *) exit 1;; esac');
    Lines.Add('fi');
    Lines.Add('');
    Lines.Add('progress ''Rücksicherung des bisherigen Datenbankstands und der Compose-Datei vorbereiten''');
    Lines.Add('recovery=$(mktemp -d "${compose%/*}/.paperless-recovery-$run.XXXXXX")');
    Lines.Add('cp -p -- "$compose" "$recovery/compose.original"');
    Lines.Add('[ "$(sha256sum <"$recovery/compose.original")" = "$compose_hash" ]');
    Lines.Add('db_command pg_dump --format=custom --encoding=UTF8 >"$recovery/database.original.dump" 2>/dev/null');
    Lines.Add('[ -s "$recovery/database.original.dump" ]');
    Lines.Add('extra_schemas=$(db_psql -At -c "SELECT count(*) FROM pg_namespace WHERE nspname NOT IN (''public'',''information_schema'') AND left(nspname, 3) <> ''pg_''" </dev/null 2>/dev/null)');
    Lines.Add('if [ "$extra_schemas" = 0 ]; then rollback_db_supported=1; fi');
    Lines.Add('');
    Lines.Add('# Retain the old files until the new installation answers or the rollback succeeds.');
    Lines.Add('# Alte Dateien behalten, bis Paperless antwortet oder die Rücksicherung abgeschlossen ist.');
    Lines.Add('changed=1');
    Lines.Add('for role in data media export; do');
    Lines.Add('  progress "Volume $role wiederherstellen"');
    Lines.Add('  python3 /restore/restore_files.py replace "/target-$role" "$run" >/dev/null 2>&1');
    Lines.Add('done');
    // Apply the schema reset and the checked SQL dump in the same psql transaction.
    // Das Schema zurücksetzen und den geprüften SQL-Dump in derselben psql-Transaktion einspielen.
    Lines.Add('progress ''PostgreSQL-Dump in einer Transaktion einspielen''');
    Lines.Add('db_changed=1');
    Lines.Add('if db_psql -q -1 -c ''DROP SCHEMA public CASCADE; CREATE SCHEMA public;'' -f - < /restore/restore.sql >/dev/null 2>"$recovery/sql.error"; then');
    Lines.Add('  :');
    Lines.Add('else');
    Lines.Add('  import_exit=$?');
    // Exit 3 is a script error under ON_ERROR_STOP. With -1, psql rolls back the transaction.
    // Exitcode 3 ist ein Skriptfehler mit ON_ERROR_STOP. Mit -1 rollt psql die Transaktion zurück.
    Lines.Add('  if [ "$import_exit" -eq 3 ]; then db_changed=0; fi');
    Lines.Add('  grep -Eo ''ERROR:[[:space:]]+[0-9A-Z]{5}([[:space:]]|$)'' "$recovery/sql.error" | tail -n 1 || :');
    Lines.Add('  rm -f -- "$recovery/sql.error"');
    Lines.Add('  exit 1');
    Lines.Add('fi');
    Lines.Add('rm -f -- "$recovery/sql.error"');
    Lines.Add('rm -f -- /restore/restore.sql');
    Lines.Add('');
    Lines.Add('progress ''Django-Migrationsstand pruefen''');
    Lines.Add('migration_query="SELECT CASE WHEN EXISTS (SELECT 1 FROM django_migrations WHERE app=''documents'' AND name IN (''1075_workflowaction_order'',''0001_squashed'',''0002_squashed'')) THEN ''ready'' WHEN EXISTS (SELECT 1 FROM django_migrations WHERE app=''documents'') THEN ''legacy'' ELSE ''unknown'' END;"');
