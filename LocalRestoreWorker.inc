  Lines.Add('function Restore-Container([string]$Service) {');
  Lines.Add('  $ids = @(docker compose -f $ComposeFile ps -a -q $Service)');
  Lines.Add('  if ($LASTEXITCODE -ne 0 -or $ids.Count -ne 1 -or $ids[0] -notmatch ''^[a-f0-9]{12,64}$'') {');
  Lines.Add('    throw "Compose-Dienst $Service konnte nicht eindeutig ermittelt werden."');
  Lines.Add('  }');
  Lines.Add('  return $ids[0]');
  Lines.Add('}');
  Lines.Add('function Restore-Running([string]$Container) {');
  Lines.Add('  $state = docker inspect --format ''{{.State.Running}}'' $Container');
  Lines.Add('  if ($LASTEXITCODE -ne 0) { throw ''Der Containerstatus konnte nicht ermittelt werden.'' }');
  Lines.Add('  return $state -eq ''true''');
  Lines.Add('}');
  Lines.Add('function Wait-RestoreDatabase {');
  Lines.Add('  for ($attempt = 0; $attempt -lt 60; $attempt++) {');
  Lines.Add('    docker exec --user postgres $DatabaseContainer pg_isready -U paperless -d paperless | Out-Null');
  Lines.Add('    if ($LASTEXITCODE -eq 0) { return }');
  Lines.Add('    Start-Sleep -Seconds 2');
  Lines.Add('  }');
  Lines.Add('  throw ''PostgreSQL wurde innerhalb von 120 Sekunden nicht bereit.''');
  Lines.Add('}');
  Lines.Add('function Write-RestoreConfig([string]$Target, [byte[]]$Bytes) {');
  Lines.Add('  $staged = $Target + ''.restore-'' + [guid]::NewGuid().ToString(''N'')');
  Lines.Add('  $discard = $staged + ''.old''');
  Lines.Add('  try {');
  Lines.Add('    [IO.File]::WriteAllBytes($staged, $Bytes)');
  Lines.Add('    if ([IO.File]::Exists($Target)) { [IO.File]::Replace($staged, $Target, $discard) }');
  Lines.Add('    else { [IO.File]::Move($staged, $Target) }');
  Lines.Add('  } finally {');
  Lines.Add('    Remove-Item -LiteralPath $staged,$discard -Force -ErrorAction SilentlyContinue');
  Lines.Add('  }');
  Lines.Add('}');
  Lines.Add('function Start-RestoreWeb {');
  Lines.Add('  param([bool]$Recreate, [string]$ExpectedKey = '''')');
  Lines.Add('  if ($Recreate) {');
  Lines.Add('    Invoke-DockerStep { docker compose -f $ComposeFile up --no-start --no-deps --force-recreate --pull never paperless } ''Der Paperless-Container konnte nicht vorbereitet werden.''');
  Lines.Add('  }');
  Lines.Add('  $id = Restore-Container ''paperless''');
  Lines.Add('  $inspected = docker inspect $id');
  Lines.Add('  if ($LASTEXITCODE -ne 0) { throw ''Die Paperless-Datenträger konnten vor dem Start nicht geprüft werden.'' }');
  Lines.Add('  $info = @(($inspected -join [Environment]::NewLine) | ConvertFrom-Json)[0]');
  Lines.Add('  foreach ($role in $roles) {');
  Lines.Add('    $mount = @($info.Mounts | Where-Object { $_.Destination -ceq "/usr/src/paperless/$role" })');
  Lines.Add('    if ($mount.Count -ne 1 -or -not $mount[0].RW -or $mount[0].Source.TrimEnd(''/'') -cne $originalSources[$role]) {');
  Lines.Add('      throw "Die Compose-Datei verweist auf einen anderen Datenträger für $role."');
  Lines.Add('    }');
  Lines.Add('  }');
  Lines.Add('  if ($ExpectedKey) {');
  Lines.Add('    $keyEntries = @($info.Config.Env | Where-Object { $_ -clike ''PAPERLESS_SECRET_KEY=*'' })');
  Lines.Add('    if ($keyEntries.Count -ne 1 -or $keyEntries[0] -cne (''PAPERLESS_SECRET_KEY='' + $ExpectedKey)) {');
  Lines.Add('      throw ''Der vorbereitete Paperless-Schlüssel ist im Container nicht wirksam.''');
  Lines.Add('    }');
  Lines.Add('  }');
  Lines.Add('  Invoke-DockerStep { docker start $id } ''Paperless konnte nicht gestartet werden.''');
  Lines.Add('  Wait-LocalPaperless $id');
  Lines.Add('}');
  Lines.Add('function Get-RestoreHash([string]$Path) {');
  Lines.Add('  $stream = [IO.File]::OpenRead($Path)');
  Lines.Add('  try {');
  Lines.Add('    $hash = [Security.Cryptography.SHA256]::Create()');
  Lines.Add('    try { return [Convert]::ToBase64String($hash.ComputeHash($stream)) }');
  Lines.Add('    finally { $hash.Dispose() }');
  Lines.Add('  } finally { $stream.Dispose() }');
  Lines.Add('}');
  Lines.Add('function Assert-RestoreConfig {');
  Lines.Add('  if ((Get-RestoreHash $ComposeFile) -cne $composeHash) {');
  Lines.Add('    throw ''Die Compose-Datei wurde während der Wiederherstellung geändert.''');
  Lines.Add('  }');
  Lines.Add('  if ($ApplyRestoreMail -and ($mailExisted -ne [IO.File]::Exists($mailPath) -or');
  Lines.Add('      ($mailExisted -and (Get-RestoreHash $mailPath) -cne $mailHash))) {');
  Lines.Add('    throw ''Die Maildatei wurde während der Wiederherstellung geändert.''');
  Lines.Add('  }');
  Lines.Add('}');
  Lines.Add('function Restore-Tar([string]$Role, [string]$Prefix, [bool]$Extract) {');
  Lines.Add('  $dest = "/usr/src/paperless/$Role"');
  Lines.Add('  $archive = "/restore/$Prefix-$Role.tar.gz"');
  Lines.Add('  if ($Extract) {');
  Lines.Add('    Invoke-DockerStep { docker run --rm --network none --volumes-from $mountAnchor -v "$($RestoreWorkDir):/restore:ro" alpine sh /restore/replace.sh $dest $archive } "Archiv für $Role konnte nicht eingespielt werden."');
  Lines.Add('  } else {');
  Lines.Add('    Invoke-DockerStep { docker run --rm --network none --volumes-from "$($mountAnchor):ro" -v "$($RestoreWorkDir):/restore" alpine tar -czf $archive -C $dest . } "Bisherige Daten für $Role konnten nicht gesichert werden."');
  Lines.Add('    Invoke-DockerStep { docker run --rm --network none -v "$($RestoreWorkDir):/restore:ro" alpine tar -tzf $archive | Out-Null } "Rückfallarchiv für $Role ist nicht lesbar."');
  Lines.Add('  }');
  Lines.Add('}');
  Lines.Add('function Restore-Sql([string]$Path) {');
  Lines.Add('  # Preserve the SQL bytes and run the reset and import in the same transaction.');
  Lines.Add('  # SQL-Datei bytegetreu übertragen und Schema-Reset sowie Import in derselben Transaktion ausführen.');
  Lines.Add('  $remote = ''/tmp/paperless-restore-'' + [guid]::NewGuid().ToString(''N'') + ''.sql''');
  Lines.Add('  try {');
  Lines.Add('    Invoke-DockerStep { docker cp $Path ($DatabaseContainer + '':'' + $remote) } ''SQL-Datei konnte nicht übertragen werden.''');
  Lines.Add('    Invoke-DockerStep { docker exec --user root $DatabaseContainer chown postgres:postgres $remote } ''SQL-Dateirechte konnten nicht gesetzt werden.''');
  Lines.Add('    Invoke-DockerStep { docker exec --user root $DatabaseContainer chmod 0600 $remote } ''SQL-Dateirechte konnten nicht gesetzt werden.''');
  Lines.Add('    Invoke-DockerStep { docker exec --user postgres $DatabaseContainer psql -X -w -U paperless -d paperless -v ON_ERROR_STOP=1 -1 -c ''DROP SCHEMA public CASCADE; CREATE SCHEMA public;'' -f $remote } ''PostgreSQL-Import ist fehlgeschlagen.''');
  Lines.Add('  } finally {');
  Lines.Add('    docker exec --user root $DatabaseContainer rm -f -- $remote | Out-Null');
  Lines.Add('  }');
  Lines.Add('}');
  Lines.Add('function Save-RestoreDatabase {');
  Lines.Add('  $remote = ''/tmp/paperless-rollback-'' + [guid]::NewGuid().ToString(''N'') + ''.sql''');
  Lines.Add('  $snapshot = Join-Path $RestoreWorkDir ''previous.sql''');
  Lines.Add('  try {');
  Lines.Add('    Invoke-DockerStep { docker exec --user postgres $DatabaseContainer pg_dump -w -U paperless -d paperless --schema=public --encoding=UTF8 -f $remote } ''Bisherige Datenbank konnte nicht gesichert werden.''');
  Lines.Add('    Invoke-DockerStep { docker cp ($DatabaseContainer + '':'' + $remote) $snapshot } ''Bisherige Datenbank konnte nicht lokal gesichert werden.''');
  Lines.Add('    if ((Get-Item -LiteralPath $snapshot).Length -eq 0) { throw ''Die Rückfallsicherung der Datenbank ist leer.'' }');
  Lines.Add('  } finally {');
  Lines.Add('    docker exec --user postgres $DatabaseContainer rm -f -- $remote | Out-Null');
  Lines.Add('  }');
  Lines.Add('}');
  Lines.Add('');
  Lines.Add('try {');
  AddLocalOperationLock(Lines);
  Lines.Add('  Set-Location -LiteralPath $ComposeDir');
  Lines.Add('  Start-Transcript -LiteralPath $RestoreLog -NoClobber | Out-Null');
  Lines.Add('  $roles = @(''data'',''media'',''export'')');
  Lines.Add('  $mountAnchor = $null');
  Lines.Add('  $dbStarted = $false');
  Lines.Add('  $brokerStarted = $false');
  Lines.Add('  $webTouched = $false');
  Lines.Add('  $mutatedRoles = @()');
  Lines.Add('  $dbChanged = $false');
  Lines.Add('  $composeChanged = $false');
  Lines.Add('  $mailChanged = $false');
  Lines.Add('  $keepRecovery = $false');
  Lines.Add('  $mailPath = Join-Path $ComposeDir ''email-versand.env''');
  Lines.Add('  $candidate = Join-Path $ComposeDir (''.paperless-restore-'' + [guid]::NewGuid().ToString(''N'') + ''.yml'')');
  Lines.Add('  $utf8 = [Text.UTF8Encoding]::new($false, $true)');
  Lines.Add('  try {');
  Lines.Add('    $composeHash = (Get-RestoreHash $ComposeFile)');
  Lines.Add('    $web = Restore-Container ''paperless''');
  Lines.Add('    $DatabaseContainer = Restore-Container ''db''');
  Lines.Add('    $webRunning = Restore-Running $web');
  Lines.Add('    $dbRunning = Restore-Running $DatabaseContainer');
  Lines.Add('    $broker = Restore-Container ''broker''');
  Lines.Add('    $brokerRunning = Restore-Running $broker');
  Lines.Add('    $inspected = docker inspect $web');
  Lines.Add('    if ($LASTEXITCODE -ne 0) { throw ''Paperless-Datenträger konnten nicht geprüft werden.'' }');
  Lines.Add('    $webInfo = @(($inspected -join [Environment]::NewLine) | ConvertFrom-Json)[0]');
  Lines.Add('    $sources = @()');
  Lines.Add('    $originalSources = @{}');
  Lines.Add('    foreach ($role in $roles) {');
  Lines.Add('      $path = "/usr/src/paperless/$role"');
  Lines.Add('      $mount = @($webInfo.Mounts | Where-Object { $_.Destination -ceq $path })');
  Lines.Add('      if ($mount.Count -ne 1 -or -not $mount[0].RW -or $mount[0].Type -notin @(''volume'',''bind'') -or -not $mount[0].Source) {');
  Lines.Add('        throw "Schreibbarer Paperless-Datenträger für $role fehlt."');
  Lines.Add('      }');
  Lines.Add('      $sourcePath = $mount[0].Source.TrimEnd(''/'')');
  Lines.Add('      foreach ($known in $sources) {');
  Lines.Add('        if ($sourcePath -eq $known -or $sourcePath.StartsWith($known + ''/'') -or $known.StartsWith($sourcePath + ''/'')) {');
  Lines.Add('          throw ''Paperless-Datenträger verwenden überlappende Quellen.''');
  Lines.Add('        }');
  Lines.Add('      }');
  Lines.Add('      $sources += $sourcePath');
  Lines.Add('      $originalSources[$role] = $sourcePath');
  Lines.Add('    }');
  Lines.Add('');
  Lines.Add('    Write-Host ''Archive und SQL-Datei vorbereiten und prüfen ...''');
  Lines.Add('    foreach ($role in $roles) {');
  Lines.Add('      $source = Join-Path $BackupDir $ArchiveNames[$role]');
  Lines.Add('      Copy-Item -LiteralPath $source -Destination (Join-Path $RestoreWorkDir "incoming-$role.tar.gz")');
  Lines.Add('    }');
  Lines.Add('    $restoreSql = Join-Path $RestoreWorkDir ''incoming.sql''');
  Lines.Add('    Copy-Item -LiteralPath $DumpFile -Destination $restoreSql');
  Lines.Add('    $replace = @''');
  Lines.Add('set -eu');
  Lines.Add('dest=$1');
  Lines.Add('archive=$2');
  Lines.Add('test -d "$dest"');
  Lines.Add('for item in "$dest"/* "$dest"/.[!.]* "$dest"/..?*; do');
  Lines.Add('  [ -e "$item" ] || [ -L "$item" ] || continue');
  Lines.Add('  rm -rf -- "$item"');
  Lines.Add('done');
  Lines.Add('tar -xzf "$archive" -C "$dest"');
  Lines.Add('''@');
  Lines.Add('    [IO.File]::WriteAllText((Join-Path $RestoreWorkDir ''replace.sh''), $replace.Replace([string][char]13,'''') + [char]10, $utf8)');
  Lines.Add('    Assert-PaperlessBackupArchives $RestoreWorkDir $webInfo.Image ''incoming.sql'' @(''incoming-data.tar.gz'',''incoming-media.tar.gz'',''incoming-export.tar.gz'')');
  Lines.Add('');
  Lines.Add('    if ($ApplyRestoreKey) {');
  Lines.Add('      $oldCompose = [IO.File]::ReadAllBytes($ComposeFile)');
  Lines.Add('      [IO.File]::WriteAllBytes((Join-Path $RestoreWorkDir ''previous-compose.yml''), $oldCompose)');
  Lines.Add('      $key = [IO.File]::ReadAllText((Join-Path $RestoreWorkDir ''requested-key.txt''), $utf8)');
  Lines.Add('      $yaml = [IO.File]::ReadAllText($ComposeFile, $utf8)');
  Lines.Add('      $pattern = [regex]''(?m)^([ \t]+PAPERLESS_SECRET_KEY:[ \t]*)[^\r\n]*''');
  Lines.Add('      if ($pattern.Matches($yaml).Count -ne 1) { throw ''Der Paperless-Schlüssel ist in Compose nicht eindeutig definiert.'' }');
  Lines.Add('      $value = ConvertTo-Json -InputObject ($key.Replace(''$'',''$$'')) -Compress');
  Lines.Add('      $updated = $pattern.Replace($yaml, { param($match) $match.Groups[1].Value + $value }, 1)');
  Lines.Add('      [IO.File]::WriteAllText($candidate, $updated, $utf8)');
  Lines.Add('      Invoke-DockerStep { docker compose -f $candidate config --quiet } ''Die vorbereitete Compose-Datei ist ungültig.''');
  Lines.Add('    }');
  Lines.Add('    if ($ApplyRestoreMail) {');
  Lines.Add('      $mailExisted = [IO.File]::Exists($mailPath)');
  Lines.Add('      if ($mailExisted) {');
  Lines.Add('        $mailHash = (Get-RestoreHash $mailPath)');
  Lines.Add('        $oldMail = [IO.File]::ReadAllBytes($mailPath)');
  Lines.Add('        [IO.File]::WriteAllBytes((Join-Path $RestoreWorkDir ''previous-mail.env''), $oldMail)');
  Lines.Add('      }');
  Lines.Add('      $mail = [IO.File]::ReadAllText((Join-Path $RestoreWorkDir ''requested-mail.env''), $utf8)');
  Lines.Add('      foreach ($entry in @(''PAPERLESS_EMAIL_PORT=25'',''PAPERLESS_EMAIL_USE_TLS=false'',''PAPERLESS_EMAIL_USE_SSL=false'')) {');
  Lines.Add('        $name = $entry.Split(''='')[0]');
  Lines.Add('        if ($mail -notmatch (''(?m)^'' + $name + ''='')) { $mail += [Environment]::NewLine + $entry }');
  Lines.Add('        else { $mail = $mail -replace (''(?m)^'' + $name + ''=[ \t]*(?=\r?$)''), $entry }');
  Lines.Add('      }');
  Lines.Add('    }');
  Lines.Add('    # Preserve access to the original mounts across Compose recreation.');
  Lines.Add('    # Die bisherigen Datenträger auch nach einer Compose-Neuerstellung verfügbar halten.');
  Lines.Add('    $mountAnchor = docker create --network none --volumes-from $web alpine true');
  Lines.Add('    if ($LASTEXITCODE -ne 0 -or $mountAnchor -notmatch ''^[a-f0-9]{64}$'') {');
  Lines.Add('      $mountAnchor = $null');
  Lines.Add('      throw ''Die Datenträger konnten nicht für die Wiederherstellung reserviert werden.''');
  Lines.Add('    }');
  Lines.Add('    if ($webRunning) {');
  Lines.Add('      $webTouched = $true');
  Lines.Add('      Invoke-DockerStep { docker compose -f $ComposeFile stop paperless } ''Paperless konnte nicht gestoppt werden.''');
  Lines.Add('    }');
  Lines.Add('    if (-not $dbRunning) {');
  Lines.Add('      $dbStarted = $true');
  Lines.Add('      Invoke-DockerStep { docker start $DatabaseContainer } ''PostgreSQL konnte nicht gestartet werden.''');
  Lines.Add('    }');
  Lines.Add('    Wait-RestoreDatabase');
  Lines.Add('    $dbVersion = docker exec --user postgres $DatabaseContainer psql -X -w -U paperless -d paperless -Atc ''SHOW server_version_num;''');
  Lines.Add('    if ($LASTEXITCODE -ne 0 -or $dbVersion -notmatch ''^18[0-9]{4}$'') { throw ''Die Wiederherstellung benötigt PostgreSQL 18.'' }');
  Lines.Add('    Write-Host ''Rückfallsicherung des bisherigen Bestands erstellen ...''');
  Lines.Add('    foreach ($role in $roles) { Restore-Tar $role ''previous'' $false }');
  Lines.Add('    Save-RestoreDatabase');
  Lines.Add('    Assert-RestoreConfig');
  Lines.Add('');
  Lines.Add('    foreach ($role in $roles) {');
  Lines.Add('      Write-Host "Volume $role wiederherstellen ..."');
  Lines.Add('      $mutatedRoles += $role');
  Lines.Add('      Restore-Tar $role ''incoming'' $true');
  Lines.Add('    }');
  Lines.Add('    Write-Host ''PostgreSQL in einer Transaktion wiederherstellen ...''');
  Lines.Add('    $dbChanged = $true');
  Lines.Add('    Restore-Sql $restoreSql');
  Lines.Add('    if (-not $brokerRunning) {');
  Lines.Add('      $brokerStarted = $true');
  Lines.Add('      Invoke-DockerStep { docker start $broker } ''Der Paperless-Broker konnte nicht gestartet werden.''');
  Lines.Add('    }');
  AddRestoreMigrations(Lines);
  Lines.Add('    Assert-RestoreConfig');
  Lines.Add('    if ($ApplyRestoreKey) {');
  Lines.Add('      Write-RestoreConfig $ComposeFile ([IO.File]::ReadAllBytes($candidate))');
  Lines.Add('      $composeChanged = $true');
  Lines.Add('    }');
  Lines.Add('    if ($ApplyRestoreMail) {');
  Lines.Add('      Write-RestoreConfig $mailPath ($utf8.GetBytes($mail))');
  Lines.Add('      $mailChanged = $true');
  Lines.Add('    }');
  Lines.Add('    $webTouched = $true');
  Lines.Add('    Start-RestoreWeb ($composeChanged -or $mailChanged) $key');
  Lines.Add('    Write-Host ''Wiederherstellung abgeschlossen. Die Paperless-Weboberfläche ist erreichbar.''');
  Lines.Add('  } catch {');
  Lines.Add('    $failure = $_.Exception.Message');
  Lines.Add('    $errors = @()');
  Lines.Add('    if ($mutatedRoles.Count -or $dbChanged -or $composeChanged -or $mailChanged) {');
  Lines.Add('      Write-Host ''Wiederherstellung fehlgeschlagen. Der bisherige Bestand wird zurückgespielt ...''');
  Lines.Add('      $webStopped = $false');
  Lines.Add('      try {');
  Lines.Add('        Invoke-DockerStep { docker compose -f $ComposeFile stop paperless } ''Paperless konnte für die Rückkehr nicht gestoppt werden.''');
  Lines.Add('        $webStopped = $true');
  Lines.Add('      } catch { $errors += $_.Exception.Message }');
  Lines.Add('      if ($webStopped) {');
  Lines.Add('        foreach ($role in $mutatedRoles) {');
  Lines.Add('          try { Restore-Tar $role ''previous'' $true } catch { $errors += $_.Exception.Message }');
  Lines.Add('        }');
  Lines.Add('        if ($dbChanged) {');
  Lines.Add('          try { Restore-Sql (Join-Path $RestoreWorkDir ''previous.sql'') } catch { $errors += $_.Exception.Message }');
  Lines.Add('        }');
  Lines.Add('      }');
  Lines.Add('    }');
  Lines.Add('    if ($composeChanged) {');
  Lines.Add('      try { Write-RestoreConfig $ComposeFile $oldCompose } catch { $errors += $_.Exception.Message }');
  Lines.Add('    }');
  Lines.Add('    if ($mailChanged) {');
  Lines.Add('      try {');
  Lines.Add('        if ($mailExisted) { Write-RestoreConfig $mailPath $oldMail }');
  Lines.Add('        else { [IO.File]::Delete($mailPath) }');
  Lines.Add('      } catch { $errors += $_.Exception.Message }');
  Lines.Add('    }');
  Lines.Add('    if ($webTouched -and $webRunning -and -not $errors.Count) {');
  Lines.Add('      try {');
  Lines.Add('        Start-RestoreWeb ($composeChanged -or $mailChanged)');
  Lines.Add('      } catch { $errors += $_.Exception.Message }');
  Lines.Add('    }');
  Lines.Add('    if ($brokerStarted -and -not $errors.Count) {');
  Lines.Add('      try { Invoke-DockerStep { docker stop $broker } ''Der ursprüngliche Broker-Status konnte nicht wiederhergestellt werden.'' }');
  Lines.Add('      catch { $errors += $_.Exception.Message }');
  Lines.Add('    }');
  Lines.Add('    if ($dbStarted -and -not $errors.Count) {');
  Lines.Add('      try { Invoke-DockerStep { docker stop $DatabaseContainer } ''Der ursprüngliche PostgreSQL-Status konnte nicht wiederhergestellt werden.'' }');
  Lines.Add('      catch { $errors += $_.Exception.Message }');
  Lines.Add('    }');
  Lines.Add('    if ($errors.Count) {');
  Lines.Add('      $keepRecovery = $true');
  Lines.Add('      $failure = $failure + '' Rückkehr fehlgeschlagen: '' + ($errors -join '' '') + " Rückfalldateien: $RestoreWorkDir"');
  Lines.Add('      Write-Host $failure');
  Lines.Add('      throw $failure');
  Lines.Add('    }');
  Lines.Add('    if ($mutatedRoles.Count -or $dbChanged -or $composeChanged -or $mailChanged) {');
  Lines.Add('      $failure += '' Der bisherige Bestand wurde wiederhergestellt.''');
  Lines.Add('      Write-Host $failure');
  Lines.Add('      throw $failure');
  Lines.Add('    }');
  Lines.Add('    Write-Host $failure');
  Lines.Add('    throw $failure');
  Lines.Add('  } finally {');
  Lines.Add('    if ($mountAnchor) {');
  Lines.Add('      docker rm $mountAnchor | Out-Null');
  Lines.Add('      if ($LASTEXITCODE -ne 0) { Write-Warning ''Der temporäre Datenträger-Container konnte nicht entfernt werden.'' }');
  Lines.Add('    }');
  Lines.Add('    if ([IO.File]::Exists($candidate)) { Remove-Item -LiteralPath $candidate -Force -ErrorAction SilentlyContinue }');
  Lines.Add('    foreach ($file in @(''incoming-data.tar.gz'',''incoming-media.tar.gz'',''incoming-export.tar.gz'',''incoming.sql'',''replace.sh'')) {');
  Lines.Add('      Remove-Item -LiteralPath (Join-Path $RestoreWorkDir $file) -Force -ErrorAction SilentlyContinue');
  Lines.Add('    }');
  Lines.Add('    if (-not $keepRecovery) {');
  Lines.Add('      foreach ($file in @(''previous-data.tar.gz'',''previous-media.tar.gz'',''previous-export.tar.gz'',''previous.sql'',''previous-compose.yml'',''previous-mail.env'')) {');
  Lines.Add('        Remove-Item -LiteralPath (Join-Path $RestoreWorkDir $file) -Force -ErrorAction SilentlyContinue');
  Lines.Add('      }');
  Lines.Add('    }');
  Lines.Add('    Stop-Transcript -ErrorAction SilentlyContinue | Out-Null');
  Lines.Add('  }');
